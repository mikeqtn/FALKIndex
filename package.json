    "db:publish": "node --disable-warning=ExperimentalWarning scripts/publish-record.ts",
    "bootstrap:admin": "node --disable-warning=ExperimentalWarning scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"scripts/*.test.ts\"",
    "test:phone": "node --disable-warning=ExperimentalWarning --test scripts/phone.check.ts",
    "images": "node --disable-warning=ExperimentalWarning scripts/images.ts"
