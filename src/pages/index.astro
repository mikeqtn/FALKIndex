---
import Base from '../layouts/Base.astro';
import ProfileStrip from '../components/ProfileStrip.astro';
import CompactStrip from '../components/CompactStrip.astro';
import ConfidenceMark from '../components/ConfidenceMark.astro';
import { CONFIDENCE, DIMENSIONS, getCatalogue, recordUrl } from '../lib/data.ts';
const { classification, dimension, methodology, orgs, record, records, sources } = await getCatalogue(Astro.locals);

// The home page is a board of tiles fitted edge to edge, like the bridges screwed to a movement's mainplate.
const infinity = record('jn-shapiro/infinity');
const resurgence = record('jn-shapiro/resurgence');
const comparable = records.filter(r => r.profile.confidence !== 'D');
const compareData = comparable.map(r => ({
  id: r.id, brand: r.brandName, model: r.model, url: recordUrl(r.id),
  cls: classification(r.profile.classification[0], r.profile.methodology).name, conf: r.profile.confidence,
  conf_text: CONFIDENCE[r.profile.confidence],
  scores: DIMENSIONS.map(d => r.profile.scores[d].value),
}));
const differ = DIMENSIONS.filter(d => infinity.profile.scores[d].value !== resurgence.profile.scores[d].value);

const tests = [
  { name: 'Design without manufacture', ids: ['fleming/series-1'], note: 'High design and movement authorship, little made in-house.' },
  { name: 'Craft on a bought movement', ids: ['artur-akmaev/eternal-koi'], note: 'Master craft on an external movement.' },
  { name: 'Partners or in-house', ids: ['awake/son-mai-guilloche-main', 'anordain/model-1-fume'], note: 'Artisan work done by partners, and artisan work done in-house.' },
  { name: 'Designed in, made out', ids: ['czapek/antarctique-sxh5'], note: 'Designed in-house, made by partners.' },
].map(t => ({ ...t, recs: t.ids.map(record) }));

// Colour photographs of real movements, openly licensed (credits in the footer and public/images/movements/CREDITS.md).
// Where the watch is in the index, the caption links to its record; none stands in for a record it is not.
const photos = {
  caseback: { src: 'nomos-duw-6101-caseback', w: 1600, h: 1600, caption: 'Nomos DUW 6101, Tangente neomatik', href: recordUrl('nomos/tangente-neomatik'), alt: 'The Nomos DUW 6101 automatic movement seen through the caseback of a Tangente neomatik.' },
  omega1861: { src: 'omega-1861', w: 1600, h: 1067, caption: 'Omega cal. 1861, base of the 3861', href: recordUrl('omega/speedmaster-moonwatch-3861'), alt: 'An Omega calibre 1861 chronograph movement, its bridges and jewels exposed.' },
  jewels: { src: 'escapement-jewels', w: 1600, h: 1754, caption: 'Escapement and jewels, close up', alt: 'A close view of a skeletonised movement: ruby jewels, a pallet fork and gold-toned wheels.' },
  omega321: { src: 'omega-321', w: 1459, h: 1280, caption: 'Omega cal. 321 chronograph', alt: 'An Omega calibre 321 chronograph movement in copper tones.' },
  angled: { src: 'nomos-duw-6101-angled', w: 1600, h: 1067, caption: 'Nomos DUW 6101 through the caseback', href: recordUrl('nomos/tangente-neomatik'), alt: 'A Nomos Tangente neomatik lying face down, its DUW 6101 movement visible through the caseback.' },
};
const img = (name: string, w: 800 | 1600) => `/images/movements/${name}-${w}.jpg`;
// The 3D movement tile: one layer per dimension, bottom to top as it lifts apart.
const parts = [
  { code: 'DH', name: 'Dial and hands' },
  { code: 'MM', name: 'Mainplate' },
  { code: 'MA', name: 'Gear train' },
  { code: 'WE', name: 'Balance and hairspring' },
  { code: 'CF', name: 'Finished bridges' },
  { code: 'PD', name: 'Rotor' },
  { code: 'EX', name: 'Case and crystal' },
];

// Open data: three records shown as cards, each a preview of what its page and data carry.
const shown = ['jn-shapiro/resurgence', 'tudor/black-bay-58', 'nomos/tangente-neomatik'].map(record).filter(Boolean);
---
<Base title="FALK Index">
  <section class="board" aria-labelledby="hero-title">
    <div class="tile t-name">
      <h1 id="hero-title" class="display">Where each watch is really made</h1>
      <div class="t-name-foot">
        <p class="lead">An open index of {records.length} watches. Seven measures show where the movement, case, dial, craft, assembly and design work happens, each linked to its sources.</p>
        <div class="actions">
          <a class="btn" href="/records/">Browse {records.length} records</a>
          <a href="/methodology/">How scoring works</a>
        </div>
      </div>
    </div>

    <div class="tile t-compare" id="compare">
      <h2 class="tile-h">Compare two watches</h2>
      <form class="pickers" aria-label="Choose two watches">
        {[infinity, resurgence].map((sel, i) => (
          <label>
            <span class="sr-only">{i ? 'Second' : 'First'} watch</span>
            <select name={`w${i}`}>
              {comparable.map(r => <option value={r.id} selected={r.id === sel.id}>{r.brandName} {r.model}</option>)}
            </select>
          </label>
        ))}
      </form>
      <div class="scroll"><ProfileStrip caption="Profiles, side by side" animate marked={differ} columns={[
        { label: infinity.model, scores: infinity.profile.scores },
        { label: resurgence.model, scores: resurgence.profile.scores },
      ]} /></div>
      <dl class="compare-cls">
        {[infinity, resurgence].map(r => (
          <div><dt>{r.model}</dt><dd><span class="cls-name">{classification(r.profile.classification[0], r.profile.methodology).name}</span> <ConfidenceMark grade={r.profile.confidence} /></dd></div>
        ))}
      </dl>
      <p class="compare-note" aria-live="polite">Same maker, different routes: {differ.length} of 7 measures differ.</p>
      <p class="small compare-links"><a href={recordUrl(infinity.id)}>{infinity.brandName} {infinity.model}</a><a href={recordUrl(resurgence.id)}>{resurgence.brandName} {resurgence.model}</a></p>
      <script type="application/json" id="compare-data" set:html={JSON.stringify(compareData)} />
    </div>

    <figure class="tile movement" id="movement" aria-labelledby="movement-cap">
      <div class="m-stage">
        <img class="m-poster" src={img(photos.caseback.src, 1600)} srcset={`${img(photos.caseback.src, 800)} 800w, ${img(photos.caseback.src, 1600)} 1600w`} sizes="(min-width: 1024px) 50vw, 100vw" width={photos.caseback.w} height={photos.caseback.h} alt={photos.caseback.alt} />
        <canvas class="m-canvas" aria-hidden="true"></canvas>
        <ol class="m-labels">
          {parts.map(p => <li hidden><a href={`/methodology/#${p.code.toLowerCase()}`}><b>{p.code}</b> {p.name}</a></li>)}
        </ol>
      </div>
      <figcaption class="m-bar">
        <span id="movement-cap">Seven measures, one movement. <span class="m-how">Drag to turn it; scroll to take it apart.</span></span>
        <button type="button" class="m-toggle" aria-pressed="false" hidden>Take it apart</button>
      </figcaption>
    </figure>
  </section>

  <section class="intro" aria-labelledby="intro-h" data-rise>
    <h2 id="intro-h" class="sr-only">What the index records</h2>
    <p class="intro-lead">A watch can be designed in one place, machined in another and finished by hand somewhere else. FALK records where each kind of work really happens, and the evidence for it.</p>
    <div class="intro-cols">
      <p><b>Seven measures.</b> Movement architecture and manufacturing, the exterior, dial and hands, craft and finishing, watchmaking execution and product development. Each is scored 0 to 5, or U where there is no evidence.</p>
      <p><b>Never a ranking.</b> Outsourcing to an expert specialist is not inferior to making a part in-house. Darker means more of the work happens inside the brand, not that the watch is better. Scores are never added together.</p>
      <p><b>Every score sourced.</b> Each measure opens to its rationale and the claims behind it: manufacturer statements, workshop documentation, supplier disclosures and interviews, each with the date it was checked.</p>
      <p><b>Open to correction.</b> Brands, watchmakers and collectors can send evidence. Every change is versioned, reviewed by an editor and kept in each record's history, so you can see what moved and why.</p>
    </div>
  </section>

  <section class="dims" aria-labelledby="dims-h">
    <div class="tile dims-statement" data-rise>
      <h2 id="dims-h" class="zig"><span>Seven measures,</span><span>never added up</span></h2>
      <figure class="dims-photo">
        <img src={img(photos.omega321.src, 1600)} srcset={`${img(photos.omega321.src, 800)} 800w, ${img(photos.omega321.src, 1600)} 1459w`} sizes="(min-width: 1024px) 40vw, 100vw" width={photos.omega321.w} height={photos.omega321.h} alt={photos.omega321.alt} loading="lazy" />
        <figcaption>{photos.omega321.caption}</figcaption>
      </figure>
      <div class="dims-foot">
        <p>Each dimension asks one question about where the work is done. The two ends of every scale are below; the full level guide is in the methodology.</p>
        <a class="btn" href="/methodology/">Read the methodology</a>
      </div>
    </div>
    <ul class="dims-rows">
      {DIMENSIONS.map(d => (
        <li>
          <h3><a href={`/methodology/#${d.toLowerCase()}`}><b>{d}</b> {dimension[d].label}</a></h3>
          <p>{dimension[d].question}</p>
          <dl>
            <div><dt>0</dt><dd>{dimension[d].levels[0]}</dd></div>
            <div><dt>5</dt><dd>{dimension[d].levels[5]}</dd></div>
          </dl>
        </li>
      ))}
    </ul>
  </section>

  <section class="tests" aria-labelledby="tests-h">
    <div class="tests-head" data-rise>
      <h2 id="tests-h"><span class="muted">Records that</span> test the method</h2>
      <a class="btn secondary" href="/records/">Browse all {records.length} records</a>
    </div>
    <div class="tests-body">
      <div class="tabs" role="tablist" aria-label="Test cases" hidden>
        {tests.map((t, i) => (
          <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <b>{t.name}</b><span>{t.recs.length} {t.recs.length === 1 ? 'record' : 'records'}</span>
          </button>
        ))}
      </div>
      <div class="panels">
        {tests.map((t, i) => (
          <div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`}>
            <h3 class="panel-h">{t.name}</h3>
            <p class="panel-note">{t.note}</p>
            <ul class="bands">
              {t.recs.map(r => (
                <li class="band">
                  <div class="band-id">
                    <span class="small muted">{r.brandName}</span>
                    <a href={recordUrl(r.id)}>{r.model}</a>
                  </div>
                  <CompactStrip scores={r.profile.scores} />
                  <div class="band-cls">
                    <span>{classification(r.profile.classification[0], r.profile.methodology).name}</span>
                    <ConfidenceMark grade={r.profile.confidence} short />
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="open" aria-labelledby="open-h">
    <div class="tile open-lead" data-rise>
      <h2 id="open-h">Open by default</h2>
      <p class="open-sentence">Every record, claim and source is published as data you can reuse and cite. No paid placement, no sponsored scores.</p>
      <ul class="open-facts">
        <li><b data-roll={records.length}>{records.length}</b><span>records</span></li>
        <li><b data-roll={orgs.size}>{orgs.size}</b><span>makers and suppliers</span></li>
        <li><b data-roll={sources.size}>{sources.size}</b><span>sources, each archived</span></li>
        <li><b>CC BY-SA 4.0</b><span>data licence</span></li>
      </ul>
      <div class="actions">
        <a class="btn" href="/data/falk.csv">Download CSV</a>
        <a class="btn secondary" href="/data/falk.json">Download JSON</a>
        <a class="open-link" href="/data/schema.json">JSON Schema</a>
      </div>
    </div>
    <div class="tile open-data" id="open-data" data-ui>
      <div class="open-tabs" role="group" aria-label="Choose a record">
        {shown.map((r, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>
            <span class="open-tab-name">{r.model}</span>
            <CompactStrip scores={r.profile.scores} />
          </button>
        ))}
      </div>
      {shown.map((r, i) => {
        const sourceCount = new Set(r.claims.map(c => c.source)).size;
        return (
          <article class="open-card" hidden={i !== 0} aria-label={`${r.brandName} ${r.model}`}>
            <header>
              <span class="small muted">{r.brandName}</span>
              <h3><a href={recordUrl(r.id)}>{r.model}</a></h3>
            </header>
            <ProfileStrip caption={`${r.model} profile`} columns={[{ scores: r.profile.scores }]} />
            <dl class="open-meta">
              <div><dt>Classification</dt><dd>{classification(r.profile.classification[0], r.profile.methodology).name}</dd></div>
              <div><dt>Evidence</dt><dd><ConfidenceMark grade={r.profile.confidence} /></dd></div>
              <div><dt>Behind it</dt><dd>{r.claims.length} claims from {sourceCount} sources</dd></div>
            </dl>
            <p class="open-card-links"><a href={recordUrl(r.id)}>Open the record</a><a href={`/records/${r.id}.json`}>This record as JSON</a></p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="about" aria-labelledby="about-h">
    <div class="about-head" data-rise>
      <h2 id="about-h">How this was built</h2>
      <p class="lead">The framework and reference dataset were developed in part with AI, which helped structure the method, compare edge cases and draft the handbook. Every profile is meant to be traceable to public sources.</p>
    </div>
    <div class="about-row">
      <figure class="tile about-photo">
        <img src={img(photos.angled.src, 1600)} srcset={`${img(photos.angled.src, 800)} 800w, ${img(photos.angled.src, 1600)} 1600w`} sizes="(min-width: 1024px) 66vw, 100vw" width={photos.angled.w} height={photos.angled.h} alt={photos.angled.alt} loading="lazy" />
        <figcaption><a href={photos.angled.href}>{photos.angled.caption}</a></figcaption>
        <p class="about-note">Provisional records come from the v0.2 handbook and are marked in gilt until an editor has attached and checked their evidence. <a href="/about/">More about the project</a></p>
      </figure>
      <div class="about-side">
        <p class="about-facts"><b>{records.length} records</b> from <b>{orgs.size} organizations</b>, citing <b>{sources.size} sources</b>. {records.filter(r => r.profile.is_seed).length} records are still provisional.</p>
        <div class="tile about-version">
          <b>{methodology.code}</b>
          <p>Every score on the site uses methodology {methodology.code}. <a href="/methodology/">Read the handbook</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Board: 12 columns, 8px gaps, rows of 84px. 9 rows = 9 × 84 + 8 × 8 = 820px, so the whole first board fits under the 60px nav at 1440 × 900. */
  .board { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 84px; gap: 8px; padding-top: 8px; }
  .tile { margin: 0; border-radius: var(--r-plate); background: var(--c-surface); overflow: hidden; }
  .t-name { grid-column: 1 / 8; grid-row: 1 / 6; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-6); padding: var(--s-6); }
  .display { font-size: clamp(48px, 6vw, 92px); line-height: 0.94; font-stretch: 70%; font-weight: 640; letter-spacing: -0.035em; max-width: 9.5em; }
  .t-name-foot { display: grid; gap: var(--s-5); }
  .t-name-foot .lead { font-size: 18px; max-width: 54ch; color: var(--c-ink-2); }
  .t-compare { grid-column: 8 / 13; grid-row: 1 / 10; display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5) var(--s-5) var(--s-5); }
  .tile-h { font-size: 20px; line-height: 1.2; font-stretch: 92%; }
  .t-compare > .scroll { flex: none; }
  .pickers { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); }
  .pickers select { width: 100%; min-height: 40px; background-color: var(--c-surface-2); border-color: transparent; font-size: 14px; text-overflow: ellipsis; }
  .t-compare :global(.strip caption) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .t-compare :global(.strip th[scope="row"]) { font-size: 18px; padding-right: var(--s-3); }
  .t-compare :global(.strip td), .t-compare :global(.strip th[scope="row"]) { height: 40px; }
  .t-compare :global(.strip .seg) { width: 13px; height: 24px; }
  .t-compare :global(.strip .segs) { gap: 2px; }
  .t-compare :global(.strip .num) { font-size: 18px; margin-left: var(--s-2); }
  .t-compare :global(.strip td.v) { padding-right: var(--s-4); }
  .t-compare :global(.strip td.name) { font-size: 14px; line-height: 1.25; }
  .t-compare :global(.strip tr.changed > th) { box-shadow: none; padding-left: 0; } /* taste-skill-ignore: removes the gilt edge here */
  .t-compare :global(.strip tr.changed td.name) { color: var(--c-ink); }
  .t-compare :global(.strip td.name .small) { display: none; }
  .compare-cls { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin: auto 0 0; padding: var(--s-4); border-radius: var(--r-control); background: var(--c-surface-2); }
  .compare-cls dt { font-size: 13px; color: var(--c-ink-2); }
  .compare-cls dd { display: grid; gap: var(--s-2); margin: 2px 0 0; font-size: 16px; font-weight: 560; }
  .compare-cls :global(.conf) { font-size: 14px; font-weight: 420; color: var(--c-ink-2); }
  .compare-cls :global(.conf b) { width: 22px; height: 22px; font-size: 12px; color: var(--c-ink); }
  .compare-note { font-size: 18px; line-height: 1.35; letter-spacing: -0.01em; }
  .compare-links { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .photo { position: relative; display: flex; flex-direction: column; }
  .photo img, .about-photo img { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; filter: contrast(1.04); }
  .photo figcaption, .about-photo figcaption { flex: none; display: flex; gap: var(--s-2); align-items: center; height: 32px; padding: 0 var(--s-3); background: var(--c-surface-2); font-size: 13px; color: var(--c-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .photo figcaption a, .about-photo figcaption a, .dims-photo figcaption a { color: inherit; text-decoration: none; }
  .photo figcaption a:hover, .about-photo figcaption a:hover { color: var(--c-ink); text-decoration: underline; }
  /* 3D movement tile: a movement drawn in code that turns, ticks and lifts apart into its seven layers. */
  .movement { grid-column: 1 / 8; grid-row: 6 / 10; display: grid; grid-template-rows: minmax(0, 1fr) auto; background: #0E1726; }
  .m-stage { position: relative; overflow: hidden; touch-action: pan-y; cursor: grab; }
  .m-stage:active { cursor: grabbing; }
  .m-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 600ms var(--ease); }
  .m-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 600ms var(--ease); }
  .movement.live .m-canvas { opacity: 1; }
  .movement.live .m-poster { opacity: 0; }
  .m-labels { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .m-labels li { position: absolute; left: 0; top: 0; }
  .movement:not(.live) .m-labels { display: none; }
  .m-labels a { pointer-events: auto; display: inline-flex; gap: var(--s-2); align-items: baseline; padding: 4px 10px; border-radius: 999px; background: rgb(11 18 30 / .72); color: #E8EDF4; font-size: 13px; text-decoration: none; white-space: nowrap; transition: background var(--d-quick) var(--ease); }
  .m-labels a:hover, .m-labels a:focus-visible { background: #E8EDF4; color: #0B121E; }
  .m-labels b { font-stretch: 62%; font-size: 15px; }
  .m-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-2) var(--s-4); padding: var(--s-3) var(--s-4); background: var(--c-surface-2); font-size: 14px; color: var(--c-ink-2); }
  .m-bar #movement-cap { color: var(--c-ink); }
  .m-how { color: var(--c-ink-2); }
  .m-toggle { min-height: 36px; padding: 0 var(--s-4); border: 0; border-radius: var(--r-control); background: var(--c-surface); color: var(--c-ink); font: 560 14px/1 var(--f-sans); cursor: pointer; transition: background var(--d-quick) var(--ease); }
  .m-toggle:hover { background: var(--c-edge); }
  .m-toggle[aria-pressed="true"] { background: var(--c-ink); color: var(--c-ink-inverse); }
  @media (prefers-reduced-motion: no-preference) {
    /* The one loud move: the tile opens like a shutter on load. */
    .m-stage { animation: shutter 1.1s var(--ease) both; }
    @keyframes shutter { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }
  }

  /* Intro: a lead line over four run-in columns. */
  .intro { padding: var(--s-10) 0 var(--s-9); }
  .intro-lead { font-size: clamp(22px, 2.2vw, 32px); line-height: 1.25; letter-spacing: -0.018em; max-width: 52ch; }
  .intro-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-5); margin-top: 72px; }
  .intro-cols p { font-size: 16px; line-height: 1.5; color: var(--c-ink-2); }
  .intro-cols b { color: var(--c-ink); font-weight: 620; }

  /* Seven measures: a statement tile beside rows that alternate tone, no rules. */
  .dims { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; }
  .dims-statement { grid-column: 1 / 6; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-6); padding: var(--s-6); background: var(--c-surface-2); }
  .dims-photo { flex: 1; display: flex; flex-direction: column; min-height: 240px; margin: 0 calc(-1 * var(--s-6)); }
  .dims-photo img { display: block; width: 100%; flex: 1; min-height: 0; object-fit: cover; object-position: 50% 75%; }
  .dims-photo figcaption { display: flex; gap: var(--s-2); align-items: center; height: 32px; padding: 0 var(--s-6); background: var(--c-surface); font-size: 14px; color: var(--c-ink-2); }
  .zig { display: grid; font-size: var(--t-h2); line-height: 1; font-stretch: 74%; font-weight: 630; letter-spacing: -0.03em; }
  .zig span:nth-child(2) { text-align: right; }
  .dims-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-5); }
  .dims-foot p { max-width: 32ch; color: var(--c-ink-2); }
  .dims-rows { grid-column: 6 / 13; display: grid; margin: 0; padding: 0; list-style: none; border-radius: var(--r-plate); overflow: hidden; }
  .dims-rows li { display: grid; grid-template-columns: 5fr 4fr 4fr; gap: var(--s-5); padding: var(--s-5) var(--s-5); background: var(--c-surface-sunk); }
  .dims-rows li:nth-child(even) { background: var(--c-surface); }
  .dims-rows h3 { font-size: 20px; line-height: 1.2; }
  .dims-rows h3 a { color: var(--c-ink); text-decoration: none; }
  .dims-rows h3 a:hover { color: var(--c-action); }
  .dims-rows h3 b { display: block; font-size: 28px; font-stretch: 62%; font-weight: 700; margin-bottom: 2px; }
  .dims-rows p { font-size: 16px; line-height: 1.45; }
  .dims-rows dl { display: grid; gap: var(--s-2); margin: 0; font-size: 14px; line-height: 1.4; color: var(--c-ink-2); }
  .dims-rows dl div { display: grid; grid-template-columns: 1.4em 1fr; }
  .dims-rows dt { font-weight: 700; color: var(--c-ink); }
  .dims-rows dd { margin: 0; }

  /* Records that test the method: tabs down the left, bands of records to the right. */
  .tests { padding-top: var(--s-10); }
  .tests-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-4); }
  .tests-head h2 { font-size: var(--t-h2); line-height: 1.02; font-stretch: 74%; font-weight: 630; letter-spacing: -0.03em; max-width: 9em; }
  .tests-head h2 .muted { display: block; }
  .tests-body { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: var(--s-5); margin-top: 56px; }
  .tabs { display: grid; align-content: start; gap: 6px; }
  .tabs button {
    display: grid; gap: 2px; min-height: 72px; padding: var(--s-3) var(--s-4); border: 0; border-radius: var(--r-control);
    background: var(--c-surface); color: var(--c-ink); text-align: left; font: inherit; cursor: pointer;
    transition: background var(--d-quick) var(--ease);
  }
  .tabs button b { font-size: 16px; font-weight: 580; }
  .tabs button span { font-size: 13px; color: var(--c-ink-2); }
  .tabs button:hover { background: var(--c-surface-2); }
  .tabs button[aria-selected="true"] { background: var(--c-ink); color: var(--c-ink-inverse); }
  .tabs button[aria-selected="true"] span { color: inherit; opacity: .75; }
  .panels { display: grid; gap: var(--s-7); }
  .js-tabs .panels { gap: 0; }
  .panel-h { font-size: 20px; }
  .js-tabs .panel-h { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .panel-note { font-size: var(--t-lead); line-height: 1.3; letter-spacing: -0.012em; margin: var(--s-2) 0 var(--s-5); }
  .js-tabs .panel-note { margin-top: 0; }
  .bands { display: grid; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .band { display: grid; grid-template-columns: minmax(0, 1.2fr) auto minmax(0, 1fr); align-items: center; gap: var(--s-5); min-height: 76px; padding: var(--s-3) var(--s-5); border-radius: var(--r-control); background: var(--c-surface); position: relative; transition: background var(--d-quick) var(--ease); }
  .band:nth-child(even) { background: var(--c-surface-2); }
  .band:hover { background: var(--c-edge); }
  .band-id { display: grid; }
  .band-id a { color: var(--c-ink); font-size: 18px; font-weight: 580; text-decoration: none; }
  .band-id a::after { content: ''; position: absolute; inset: 0; }
  .band-id a:focus-visible { outline: none; }
  .band:has(a:focus-visible) { outline: 2px solid var(--c-focus); outline-offset: 2px; }
  .band-cls { display: flex; justify-content: flex-end; align-items: center; gap: var(--s-3); font-size: 15px; text-align: right; }

  /* Open data: the facts on an engine-turned tile, beside a real excerpt of the data itself. */
  .open { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; margin-top: var(--s-10); }
  .open-lead { grid-column: 1 / 7; display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-6); background: #14233F url(/images/guilloche-1600.jpg) 20% 50% / cover; color: #F7F8FA; }
  .open-lead h2 { font-size: var(--t-h2); line-height: 1; font-stretch: 74%; font-weight: 640; letter-spacing: -0.03em; }
  .open-sentence { font-size: 18px; line-height: 1.45; max-width: 40ch; color: #C9D3E2; }
  .open-facts { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4) var(--s-5); margin: auto 0 0; padding: 0; list-style: none; font-size: 16px; color: #C9D3E2; }
  /* A fixed number column, so no label ever sits above the next figure. */
  .open-facts li { display: grid; grid-template-columns: clamp(66px, 5.6vw, 88px) minmax(0, 1fr); align-items: baseline; gap: var(--s-3); }
  .open-facts li b { justify-self: start; }
  .open-facts li:last-child { grid-column: 1 / -1; grid-template-columns: auto minmax(0, 1fr); }
  .open-facts b { font-size: clamp(32px, 3.4vw, 48px); line-height: 1; font-weight: 640; font-stretch: 74%; letter-spacing: -0.02em; color: #F7F8FA; font-variant-numeric: tabular-nums; }
  .open-facts li:last-child b { font-size: clamp(22px, 2vw, 28px); }
  .open-lead .btn.secondary { background: rgb(255 255 255 / .1); color: #F7F8FA; }
  .open-lead .btn.secondary:hover { background: rgb(255 255 255 / .18); }
  .open-link { color: #F7F8FA; }
  .open-data { grid-column: 7 / 13; display: flex; flex-direction: column; background: var(--c-surface-sunk); }
  .open-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; padding: var(--s-3); }
  .open-tabs button { display: grid; gap: var(--s-2); justify-items: start; padding: var(--s-3); border: 0; border-radius: var(--r-control); background: transparent; color: var(--c-ink-2); font: 500 14px/1.2 var(--f-sans); text-align: left; cursor: pointer; transition: background var(--d-quick) var(--ease), color var(--d-quick) var(--ease); }
  .open-tabs button:hover { background: var(--c-surface); color: var(--c-ink); }
  .open-tabs button[aria-pressed="true"] { background: var(--c-surface-2); color: var(--c-ink); }
  .open-tabs :global(.cstrip) { gap: 2px; }
  .open-tabs :global(.cell) { width: 18px; height: 18px; font-size: 10px; }
  .open-card { flex: 1; display: grid; align-content: start; gap: var(--s-4); padding: var(--s-2) var(--s-5) var(--s-5); }
  .open-card header { display: grid; gap: 2px; }
  .open-card h3 { font-size: 28px; line-height: 1.1; font-stretch: 80%; }
  .open-card h3 a { color: var(--c-ink); text-decoration: none; }
  .open-card h3 a:hover { color: var(--c-action); text-decoration: underline; }
  .open-card :global(.strip caption) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .open-card :global(.strip td), .open-card :global(.strip th[scope="row"]) { height: 34px; }
  .open-card :global(.strip th[scope="row"]), .open-card :global(.strip .num) { font-size: 18px; }
  .open-card :global(.strip .seg) { width: 16px; height: 22px; }
  .open-card :global(.strip td.name) { font-size: 14px; }
  .open-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); margin: 0; }
  .open-meta dt { font-size: 13px; color: var(--c-ink-2); }
  .open-meta dd { margin: 2px 0 0; font-size: 15px; font-weight: 520; }
  .open-meta :global(.conf) { font-size: 14px; font-weight: 420; }
  .open-meta :global(.conf b) { width: 22px; height: 22px; font-size: 12px; }
  .open-card-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: 15px; }
  @media (prefers-reduced-motion: no-preference) {
    .open-card:not([hidden]) { animation: card-in 420ms var(--ease) both; }
    @keyframes card-in { from { opacity: 0; translate: 0 8px; } }
  }

  /* How this was built: a wide photograph with a note set into its corner, and a colour tile with the facts. */
  .about { padding-top: var(--s-10); }
  .about-head h2 { font-size: var(--t-h2); line-height: 1.02; font-stretch: 74%; font-weight: 630; letter-spacing: -0.03em; }
  .about-head .lead { margin-top: var(--s-5); max-width: 52ch; }
  .about-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-4); margin-top: 72px; align-items: start; }
  .about-photo { grid-column: 1 / 9; position: relative; display: flex; flex-direction: column; }
  .about-photo img { aspect-ratio: 16 / 10; }
  .about-note { position: absolute; top: 0; right: 0; width: 320px; padding: var(--s-5); background: var(--c-page); border-radius: 0 0 0 var(--r-plate); font-size: 16px; line-height: 1.5; }
  .about-side { grid-column: 9 / 13; display: grid; gap: var(--s-5); }
  /* Engine-turned ground, generated in the palette's own blues; the text stays light in both themes. */
  .about-version { display: grid; align-content: space-between; gap: var(--s-4); aspect-ratio: 4 / 3; padding: var(--s-5); background: #14233F url(/images/guilloche-1200.jpg) 30% 50% / cover; color: #F7F8FA; }
  .about-version b { font-size: clamp(64px, 7vw, 112px); line-height: .9; font-stretch: 62%; font-weight: 720; letter-spacing: -0.03em; }
  .about-version p { font-size: 16px; line-height: 1.45; max-width: 26ch; }
  .about-version a { color: inherit; font-weight: 600; }
  .about-facts { font-size: var(--t-lead); line-height: 1.35; letter-spacing: -0.012em; color: var(--c-ink-2); }
  .about-facts b { font-weight: 600; color: var(--c-ink); }

  @media (max-width: 1023px) {
    .board { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; }
    .t-name { grid-column: 1 / -1; grid-row: auto; min-height: 56svh; padding: var(--s-5); }
    .t-name-foot { grid-template-columns: 1fr; }
    .t-compare { grid-column: 1 / -1; grid-row: auto; }
    .movement { grid-column: 1 / -1; grid-row: auto; }
    .m-stage { aspect-ratio: 4 / 5; }
    .intro-cols { grid-template-columns: 1fr 1fr; gap: var(--s-6) var(--s-5); }
    .dims-statement, .dims-rows { grid-column: 1 / -1; }
    .tests-body { grid-template-columns: 1fr; margin-top: var(--s-6); }
    .open-lead, .open-data { grid-column: 1 / -1; }
    .tabs { grid-auto-flow: column; grid-auto-columns: minmax(180px, 1fr); overflow-x: auto; }
    .about-photo, .about-side { grid-column: 1 / -1; }
    .about-side { grid-template-columns: 1fr 1fr; align-items: start; margin-top: var(--s-7); }
  }
  @media (max-width: 639px) {
    .t-name { min-height: 0; gap: var(--s-7); }
    .display { font-size: 12.5vw; }
    .t-name-foot .actions .btn { width: 100%; }
    .tabs { grid-auto-flow: row; grid-template-columns: 1fr 1fr; overflow: visible; }
    .tests, .about { padding-top: var(--s-9); }
    .open { margin-top: var(--s-9); }
    .compare-cls { grid-template-columns: 1fr; }
    .open-facts { grid-template-columns: 1fr; }
    .open-meta { grid-template-columns: 1fr 1fr; }
    .open-tabs :global(.cstrip) { display: none; }
    .open-tabs button { justify-items: center; text-align: center; }
    .open-lead { padding: var(--s-5); }
    .pickers { grid-template-columns: 1fr; }
    .intro { padding: var(--s-9) 0 var(--s-8); }
    .intro-cols { grid-template-columns: 1fr; margin-top: var(--s-7); }
    .dims-statement { min-height: 60svh; padding: var(--s-5); }
    .zig { font-size: 10vw; }
    .dims-rows li { grid-template-columns: 1fr; gap: var(--s-2); padding: 40px var(--s-5); }
    .band { grid-template-columns: 1fr; gap: var(--s-3); padding: var(--s-4); }
    .band-cls { justify-content: flex-start; text-align: left; }
    .about-note { position: static; width: auto; padding: var(--s-4) 0 0; border-radius: 0; background: none; }
    .about-side { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Compare: swap either watch and the two strips, the note and the links follow. Without script the Shapiro pair stays.
  const tile = document.getElementById('compare')!;
  const data: { id: string; brand: string; model: string; url: string; cls: string; conf: string; conf_text: string; scores: (number | null)[] }[] =
    JSON.parse(document.getElementById('compare-data')!.textContent!);
  const byId = new Map(data.map(d => [d.id, d]));
  const selects = [...tile.querySelectorAll('select')];
  const heads = [...tile.querySelectorAll('thead th')];
  const rows = [...tile.querySelectorAll('tbody tr')];
  const note = tile.querySelector('.compare-note')!;
  const links = [...tile.querySelectorAll<HTMLAnchorElement>('.compare-links a')];
  const cls = [...tile.querySelectorAll('.compare-cls > div')];

  function render() {
    const [a, b] = selects.map(s => byId.get(s.value)!);
    [a, b].forEach((w, col) => {
      heads[col].textContent = w.model;
      links[col].href = w.url;
      links[col].textContent = `${w.brand} ${w.model}`;
      cls[col].querySelector('dt')!.textContent = w.model;
      cls[col].querySelector('.cls-name')!.textContent = w.cls;
      cls[col].querySelector('.conf b')!.textContent = w.conf;
      cls[col].querySelector('.conf')!.lastChild!.textContent = w.conf_text;
      rows.forEach((tr, i) => {
        const v = w.scores[i];
        const cell = tr.querySelectorAll('td.v')[col];
        cell.querySelectorAll('.seg').forEach((seg, n) => { seg.className = `seg ${v === null ? 'lu' : n < v ? `l${v}` : ''}`; });
        cell.querySelector('.num')!.textContent = v === null ? 'U' : String(v);
        cell.querySelector('.sr-only')!.textContent = `${v === null ? ' unknown' : ' of 5'}, ${w.model}`;
      });
    });
    const diff = rows.filter((tr, i) => { const d = a.scores[i] !== b.scores[i]; tr.classList.toggle('changed', d); return d; }).length;
    note.textContent = a.id === b.id ? 'The same watch on both sides. Pick another to compare.'
      : `${a.brand === b.brand ? 'Same maker, different routes: ' : ''}${diff} of 7 measures differ.`;
  }
  selects.forEach(s => s.addEventListener('change', render));

  // 3D movement: load three.js only once the tile is near the screen, and only where WebGL works.
  // Without it (or without script) the photograph stays in place.
  {
    const box = document.getElementById('movement')!;
    const stage = box.querySelector<HTMLElement>('.m-stage')!;
    const canvas = box.querySelector<HTMLCanvasElement>('.m-canvas')!;
    const labels = [...box.querySelectorAll<HTMLElement>('.m-labels li')];
    const toggle = box.querySelector<HTMLButtonElement>('.m-toggle')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gl = (() => { try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; } })();
    if (still) box.querySelector('.m-how')!.textContent = 'Drag to turn it.';
    if (gl) {
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const { mountMovement } = await import('../scripts/movement.ts');
        const m = mountMovement(stage, canvas, labels, { still });
        box.classList.add('live');
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const apart = m.toggle();
          toggle.setAttribute('aria-pressed', String(apart));
          toggle.textContent = apart ? 'Put it together' : 'Take it apart';
        });
      }, { rootMargin: '200px' });
      io.observe(box);
    }
  }

  // Open data: switch which record's card is shown.
  {
    const box = document.getElementById('open-data')!;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('.open-tabs button')];
    const files = [...box.querySelectorAll<HTMLElement>('.open-card')];
    tabs.forEach((t, i) => t.addEventListener('click', () => {
      tabs.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      files.forEach((f, j) => { f.hidden = i !== j; });
    }));
  }

  // Test cases become tabs once script runs; without it every case is listed in full.
  const tablist = document.querySelector<HTMLElement>('.tabs')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
    panels.forEach((p, j) => { p.hidden = i !== j; });
    if (focus) tabs[i].focus();
  };
  tablist.hidden = false;
  document.querySelector('.tests')!.classList.add('js-tabs');
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', e => {
      const k = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (k) { e.preventDefault(); select((i + k + tabs.length) % tabs.length, true); }
    });
  });
  select(0);
</script>
