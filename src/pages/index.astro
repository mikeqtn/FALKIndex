    .tabs { grid-auto-flow: row; grid-template-columns: 1fr 1fr; overflow: visible; }
    .tests, .about { padding-top: var(--s-9); }
    .open { margin-top: var(--s-9); }
    .compare-cls { grid-template-columns: 1fr; }
    .open-facts { grid-template-columns: 1fr; }
    .open-tabs :global(.cstrip) { display: none; }
    .open-tabs button { justify-items: center; text-align: center; }
    .open-lead { padding: var(--s-5); }
    .pickers { grid-template-columns: 1fr; }
    .intro { padding: var(--s-9) 0 var(--s-8); }
    .intro-cols { grid-template-columns: 1fr; margin-top: var(--s-7); }
    .dims-statement { min-height: 60svh; padding: var(--s-5); }
    .zig { font-size: 10vw; }
    .dims-rows li { grid-template-columns: 1fr; gap: var(--s-2); padding: 40px var(--s-5); }
    .band { grid-template-columns: 1fr; gap: var(--s-3); padding: var(--s-4); }
    .band-cls { justify-content: flex-start; text-align: left; }
    .about-note { position: static; width: auto; padding: var(--s-4) 0 0; border-radius: 0; background: none; }
    .about-side { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Compare: swap either watch and the two strips, the note and the links follow. Without script the Shapiro pair stays.
  const tile = document.getElementById('compare')!;
  const data: { id: string; brand: string; model: string; url: string; cls: string; conf: string; conf_text: string; scores: (number | null)[] }[] =
    JSON.parse(document.getElementById('compare-data')!.textContent!);
  const byId = new Map(data.map(d => [d.id, d]));
  const selects = [...tile.querySelectorAll('select')];
  const heads = [...tile.querySelectorAll('thead th')];
  const rows = [...tile.querySelectorAll('tbody tr')];
  const note = tile.querySelector('.compare-note')!;
  const links = [...tile.querySelectorAll<HTMLAnchorElement>('.compare-links a')];
  const cls = [...tile.querySelectorAll('.compare-cls > div')];

  function render() {
    const [a, b] = selects.map(s => byId.get(s.value)!);
    [a, b].forEach((w, col) => {
      heads[col].textContent = w.model;
      links[col].href = w.url;
      links[col].textContent = `${w.brand} ${w.model}`;
      cls[col].querySelector('dt')!.textContent = w.model;
      cls[col].querySelector('.cls-name')!.textContent = w.cls;
      cls[col].querySelector('.conf b')!.textContent = w.conf;
      cls[col].querySelector('.conf')!.lastChild!.textContent = w.conf_text;
      rows.forEach((tr, i) => {
        const v = w.scores[i];
        const cell = tr.querySelectorAll('td.v')[col];
        cell.querySelectorAll('.seg').forEach((seg, n) => { seg.className = `seg ${v === null ? 'lu' : n < v ? `l${v}` : ''}`; });
        cell.querySelector('.num')!.textContent = v === null ? 'U' : String(v);
        cell.querySelector('.sr-only')!.textContent = `${v === null ? ' unknown' : ' of 5'}, ${w.model}`;
      });
    });
    const diff = rows.filter((tr, i) => { const d = a.scores[i] !== b.scores[i]; tr.classList.toggle('changed', d); return d; }).length;
    note.textContent = a.id === b.id ? 'The same watch on both sides. Pick another to compare.'
      : `${a.brand === b.brand ? 'Same maker, different routes: ' : ''}${diff} of 7 measures differ.`;
  }
  selects.forEach(s => s.addEventListener('change', render));

  // Inspection tile: pick a movement, and a loupe shows it magnified. It drifts on its own until a
  // pointer takes it; autoplay and drift stop off screen, in hidden tabs and under reduced motion.
  {
    const box = document.getElementById('inspect')!;
    const stage = box.querySelector<HTMLElement>('.stage')!;
    const shots = [...stage.querySelectorAll<HTMLImageElement>(':scope > .shot')];
    const caps = [...box.querySelectorAll('.cap')];
    const picks = [...box.querySelectorAll<HTMLButtonElement>('.picks button')];
    const loupe = stage.querySelector<HTMLElement>('.loupe')!;
    const view = loupe.querySelector<HTMLElement>('.loupe-view')!;
    const lens = view.querySelector<HTMLImageElement>('img')!;
    const hint = box.querySelector('.inspect-hint')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const ZOOM = 2.6;
    let active = 0, onScreen = false, held = false, raf = 0, timer = 0, last = { x: 0.5, y: 0.5 };
    if (matchMedia('(pointer: coarse)').matches) hint.textContent = 'Tap the picture to look through the loupe.';

    const show = (i: number) => {
      active = i;
      shots.forEach((s, j) => { s.classList.toggle('on', j === i); s.toggleAttribute('aria-hidden', j !== i); });
      caps.forEach((c, j) => c.toggleAttribute('hidden', j !== i));
      picks.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      const src = shots[i];
      lens.src = src.src; // always the 1600px file: the loupe magnifies it 2.6×
      lens.setAttribute('style', src.getAttribute('style') ?? '');
      place(last.x, last.y);
    };
    // Put the loupe at a point given as fractions of the stage, and slide the magnified copy under it.
    const place = (fx: number, fy: number) => {
      last = { x: fx, y: fy };
      const w = stage.clientWidth, h = stage.clientHeight, l = loupe.offsetWidth;
      const x = Math.min(Math.max(fx * w, l / 2), w - l / 2), y = Math.min(Math.max(fy * h, l / 2), h - l / 2);
      view.style.width = `${w}px`; view.style.height = `${h}px`;
      loupe.style.translate = `${x - l / 2}px ${y - l / 2}px`;
      view.style.transform = `translate(${l / 2 - x * ZOOM}px, ${l / 2 - y * ZOOM}px) scale(${ZOOM})`;
    };
    const drift = (t: number) => {
      // A slow Lissajous path, like a loupe moving across a movement plate.
      place(0.5 + 0.3 * Math.sin(t / 3100), 0.5 + 0.28 * Math.sin(t / 2300 + 1));
      raf = requestAnimationFrame(drift);
    };
    const run = () => {
      cancelAnimationFrame(raf); clearInterval(timer);
      const moving = onScreen && !held && !still.matches && !document.hidden;
      loupe.classList.toggle('show', held || moving);
      if (!moving) return;
      raf = requestAnimationFrame(drift);
      timer = window.setInterval(() => show((active + 1) % shots.length), 6500);
    };
    const fromEvent = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      held = true; place((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height); run();
    };
    stage.addEventListener('pointermove', e => { if (e.pointerType !== 'touch' || e.buttons) fromEvent(e); });
    stage.addEventListener('pointerdown', fromEvent);
    stage.addEventListener('pointerleave', e => { if (e.pointerType !== 'touch') { held = false; run(); } });
    picks.forEach((b, i) => b.addEventListener('click', () => { show(i); held = false; run(); }));
    box.addEventListener('focusin', () => { clearInterval(timer); });
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; run(); }, { threshold: 0.3 }).observe(box);
    document.addEventListener('visibilitychange', run);
    still.addEventListener('change', run);
    addEventListener('resize', () => place(last.x, last.y));
    show(0);
  }

  // Open data: switch which record's JSON is shown; the figures roll up once as the section arrives.
  {
    const box = document.getElementById('open-data')!;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('.open-tabs button')];
    const files = [...box.querySelectorAll<HTMLElement>('.open-file')];
    tabs.forEach((t, i) => t.addEventListener('click', () => {
      tabs.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      files.forEach((f, j) => { f.hidden = i !== j; });
    }));
    const figures = [...document.querySelectorAll<HTMLElement>('[data-roll]')];
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement, end = Number(el.dataset.roll), t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 900), eased = 1 - Math.pow(1 - k, 3);
          el.textContent = String(Math.round(end * eased));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }), { rootMargin: '0px 0px -15% 0px' });
      figures.forEach(f => io.observe(f));
    }
  }

  // Test cases become tabs once script runs; without it every case is listed in full.
  const tablist = document.querySelector<HTMLElement>('.tabs')!;
  const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
    panels.forEach((p, j) => { p.hidden = i !== j; });
    if (focus) tabs[i].focus();
  };
  tablist.hidden = false;
  document.querySelector('.tests')!.classList.add('js-tabs');
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', e => {
      const k = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (k) { e.preventDefault(); select((i + k + tabs.length) % tabs.length, true); }
    });
  });
  select(0);
</script>
