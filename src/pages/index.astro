---
import Base from '../layouts/Base.astro';
import ProfileStrip from '../components/ProfileStrip.astro';
import CompactStrip from '../components/CompactStrip.astro';
import ConfidenceMark from '../components/ConfidenceMark.astro';
import PatternStrip from '../components/PatternStrip.astro';
import Picture from '../components/Picture.astro';
import { CONFIDENCE, DIMENSIONS, getCatalogue, recordUrl, siteOrigin } from '../lib/data.ts';
import { ARCHETYPES, DESCRIPTOR, NOT_A_RANKING, NOT_OWNERSHIP, archetypeUrl, browseUrl, pattern, plural, recordsOf, taggedWith } from '../lib/archetypes.ts';
const { classification, methodology, orgs, record, records, sources } = await getCatalogue(Astro.locals);

// The home page teaches enough to browse: what FALK does, how a profile reads, the archetype vocabulary, one real comparison.
// The rules themselves stay on /methodology/; the archetypes are taught in full on /archetypes/.
const infinity = record('jn-shapiro/infinity');
const resurgence = record('jn-shapiro/resurgence');
const sample = record('nomos/tangente-neomatik');
const comparable = records.filter(r => r.profile.confidence !== 'D');
const origin = siteOrigin(Astro.url);
const clsName = (r: typeof infinity) => classification(r.profile.classification[0], r.profile.methodology).name;
const compareData = comparable.map(r => ({
  id: r.id, brand: r.brandName, model: r.model, url: recordUrl(r.id),
  cls: clsName(r), conf: r.profile.confidence, conf_text: CONFIDENCE[r.profile.confidence],
  scores: DIMENSIONS.map(d => r.profile.scores[d].value),
}));
const differ = DIMENSIONS.filter(d => infinity.profile.scores[d].value !== resurgence.profile.scores[d].value);

// Each archetype with its records, the pattern they show, and two examples: settled evidence first, then by name.
const order = { A: 0, B: 1, C: 2, D: 3 } as const;
const archetypes = methodology.classifications.filter(c => c.kind === 'archetype').map(c => {
  const recs = recordsOf(records, c.code);
  const tagged = taggedWith(records, c.code).length;
  const examples = [...recs].sort((a, b) => Number(a.profile.is_seed) - Number(b.profile.is_seed) || order[a.profile.confidence] - order[b.profile.confidence]).slice(0, 2);
  return { ...c, copy: ARCHETYPES[c.code], recs, tagged, examples, pattern: pattern(recs), slug: c.code.replaceAll('_', '-') };
});
const descriptor = methodology.classifications.find(c => c.code === DESCRIPTOR.code)!;
// The people behind the descriptor: every published record that carries it.
const withDescriptor = comparable.filter(r => r.profile.independent_watchmaker);

// Colour photographs of real movements, openly licensed (credits in the footer and public/images/movements/CREDITS.md).
// Where the watch is in the index, the caption links to its record; none stands in for a record it is not.
const photos = {
  caseback: { src: 'nomos-duw-6101-caseback', w: 1600, h: 1600, caption: 'Nomos DUW 6101, Tangente neomatik', href: recordUrl('nomos/tangente-neomatik'), alt: 'The Nomos DUW 6101 automatic movement seen through the caseback of a Tangente neomatik.' },
  omega1861: { src: 'omega-1861', w: 1600, h: 1067, caption: 'Omega cal. 1861, base of the 3861', href: recordUrl('omega/speedmaster-moonwatch-3861'), alt: 'An Omega calibre 1861 chronograph movement, its bridges and jewels exposed.' },
  omega321: { src: 'omega-321', w: 1459, h: 1280, caption: 'Omega cal. 321 chronograph', alt: 'An Omega calibre 321 chronograph movement in copper tones.' },
  angled: { src: 'nomos-duw-6101-angled', w: 1600, h: 1067, caption: 'Nomos DUW 6101 through the caseback', href: recordUrl('nomos/tangente-neomatik'), alt: 'A Nomos Tangente neomatik lying face down, its DUW 6101 movement visible through the caseback.' },
};
const srcset = (p: { src: string; w: number }) => `${img(p.src, 800)} 800w, ${img(p.src, 1600)} ${Math.min(p.w, 1600)}w`;
const provisional = records.filter(r => r.profile.is_seed).length;
const img = (name: string, w: 800 | 1600) => `/images/movements/${name}-${w}.jpg`;

// Open data: three records shown as cards, each a preview of what its page and data carry.
const shown = ['jn-shapiro/resurgence', 'tudor/black-bay-58', 'nomos/tangente-neomatik'].map(record).filter(Boolean);
---
<Base title="FALK Index" ld={{
  '@type': 'WebSite', name: 'FALK Index', url: `${origin}/`,
  potentialAction: { '@type': 'SearchAction', target: `${origin}/records/?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
}}>
  <section class="board" aria-labelledby="hero-title">
    <div class="tile t-name">
      <div class="t-name-head">
        <h1 id="hero-title" class="display">Who really makes your watch?</h1>
        <p class="hero-lead">Watchmaking is rarely as simple as “in-house” or “outsourced”. Some brands make nearly everything themselves; others work with specialist movement, dial and case makers and independent artisans.</p>
      </div>
      <div class="t-name-foot">
        <p class="hero-claim"><b>FALK Index documents who does what:</b> an independent, open database of how individual watches are designed, made, finished and assembled, with sources behind every finding.</p>
        <div class="actions">
          <a class="btn" href="/records/">Explore watches</a>
          <a href="#how">How it works</a>
        </div>
      </div>
    </div>
    <figure class="tile movement" aria-labelledby="movement-cap">
      <div class="m-stage">
        <Picture class="m-photo" src={img(photos.caseback.src, 1600)} srcset={`${img(photos.caseback.src, 800)} 800w, ${img(photos.caseback.src, 1600)} 1600w`} sizes="(min-width: 1024px) 42vw, 100vw" width={photos.caseback.w} height={photos.caseback.h} alt={photos.caseback.alt} />
      </div>
      <figcaption class="m-bar">
        <span id="movement-cap">{photos.caseback.caption}</span>
        <a href={photos.caseback.href}>Open its record</a>
      </figcaption>
    </figure>
  </section>

  <section class="how" id="how" aria-labelledby="how-h">
    <div class="tile how-text" data-rise>
      <h2 id="how-h" class="sec-h">Seven measures. One clearer picture.</h2>
      <p class="how-lead">Every watch is examined across seven aspects of production, from movement engineering and parts manufacturing to craft, assembly and product development. Each gets a score from 0 to 5 for how much of that work the brand does itself. Where evidence is missing the score is U, for unknown, never a guess.</p>
      <p class="how-not"><b>Higher scores don't mean a better watch.</b> Outsourcing to a specialist can be just as deliberate as making a part in-house, and the seven scores are never added up or turned into a ranking.</p>
      <a class="btn secondary" href="/methodology/">How scoring works</a>
    </div>
    <div class="tile how-sample" data-rise>
      <ProfileStrip caption={`${sample.brandName} ${sample.model}, a real profile`} columns={[{ scores: sample.profile.scores }]} animate />
      <p class="how-key small muted">Darker means more of that work happens inside the brand. Hatching means unknown.</p>
      <a class="small" href={recordUrl(sample.id)}>Open the {sample.model} record</a>
    </div>
  </section>

  <section class="arch" id="archetypes" aria-labelledby="arch-h">
    <div class="arch-head" data-rise>
      <div class="arch-title">
        <h2 id="arch-h" class="sec-h">A vocabulary for how watches are made</h2>
        <p class="arch-lead">Seven scores tell the full story. An archetype gives you the shorthand.</p>
      </div>
      <div class="arch-intro">
        <p>FALK groups watches into production archetypes: recognizable patterns across the seven scores, from design-led brands working with outside specialists to manufacturers that make most of their parts themselves. We hope these names become part of everyday collecting, so that knowing a watch's archetype tells you, in broad terms, how it was made.</p>
        <p><b>{NOT_A_RANKING}</b></p>
      </div>
    </div>

    <div class="explorer">
      <div class="arch-tabs" role="tablist" aria-label="Production archetypes" hidden>
        {archetypes.map((a, i) => (
          <button type="button" role="tab" id={`atab-${a.slug}`} aria-controls={`apanel-${a.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <b class="at-name">{a.name}</b>
            <span class="at-short">{a.copy.short}</span>
            <span class="at-foot"><PatternStrip mini pattern={a.pattern} count={a.recs.length} caption="" /><span>{plural(a.tagged, "record")}</span></span>
          </button>
        ))}
      </div>
      <div class="arch-panels">
        {archetypes.map(a => (
          <article class="tile apanel" role="tabpanel" id={`apanel-${a.slug}`} aria-labelledby={`atab-${a.slug}`}>
            <div class="ap-text">
              <h3 class="ap-name">{a.name}</h3>
              <p class="ap-short">{a.copy.short}</p>
              <h4>What it generally means</h4>
              <p>{a.copy.means}</p>
              <h4>Examples in the index</h4>
              {a.examples.length ? (
                <ul class="ap-examples">
                  {a.examples.map(r => (
                    <li>
                      <span class="ap-ex-id"><span class="small muted">{r.brandName}</span><a href={recordUrl(r.id)}>{r.model}</a></span>
                      <CompactStrip scores={r.profile.scores} />
                      <ConfidenceMark grade={r.profile.confidence} short />
                    </li>
                  ))}
                </ul>
              ) : <p class="muted">No published record carries this archetype yet.</p>}
            </div>
            <div class="ap-pattern">
              <h4>Typical score pattern</h4>
              {a.recs.length ? (
                <>
                  <PatternStrip pattern={a.pattern} count={a.recs.length} caption={`Seen across ${plural(a.recs.length, "record")} where it is the main archetype`} />
                  <p class="small muted">Tinted marks show the scores seen; the solid mark is the most common. A pattern, not a rule: the archetype is assigned from the whole profile and its evidence.</p>
                </>
              ) : <p class="muted">A pattern appears once records are published.</p>}
              <div class="actions">
                {a.tagged > 0 && <a class="btn" href={browseUrl(a.code)}>Browse {plural(a.tagged, "record")}</a>}
                <a href={archetypeUrl(a.code)}>More about {a.name}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="arch-foot">
      <div class="descriptor" data-rise>
        <div class="d-text">
          <h3>{descriptor.name}</h3>
          <p>{DESCRIPTOR.short} {DESCRIPTOR.means}</p>
          <p class="muted">{NOT_OWNERSHIP}</p>
        </div>
        {withDescriptor.length > 0 && (
          <div class="d-roll">
            <p class="d-roll-h">{plural(withDescriptor.length, 'record')} {withDescriptor.length === 1 ? 'carries' : 'carry'} it, each with its own profile</p>
            <ul>
              {withDescriptor.map(r => (
                <li>
                  <a href={recordUrl(r.id)}><span>{r.brandName}</span> {r.model}</a>
                  <CompactStrip scores={r.profile.scores} />
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="tile arch-more" data-rise>
        <figure class="arch-photo">
          <Picture src={img(photos.omega321.src, 800)} srcset={srcset(photos.omega321)} sizes="(min-width: 1024px) 30vw, 100vw" width={photos.omega321.w} height={photos.omega321.h} alt={photos.omega321.alt} loading="lazy" />
          <figcaption class="sr-only">{photos.omega321.caption}</figcaption>
        </figure>
        <div class="arch-more-text">
          <p>Borderline cases, every archetype side by side, and their formal definitions.</p>
          <a class="btn secondary" href="/archetypes/">All production archetypes</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cmp" aria-labelledby="cmp-h">
    <div class="cmp-text" data-rise>
      <h2 id="cmp-h" class="sec-h">Same maker, two archetypes</h2>
      <p class="cmp-statement">The scores are the evidence. The archetype is the shorthand.</p>
      <p>J.N. Shapiro makes both watches here. The {infinity.model} pairs a dial Josh Shapiro engine-turns himself with a bought-in movement, so it is an <a href={archetypeUrl(infinity.profile.classification[0])}>{clsName(infinity)}</a>. For the {resurgence.model}, the movement, case and dial are all made in the workshop, so it is an <a href={archetypeUrl(resurgence.profile.classification[0])}>{clsName(resurgence)}</a>.</p>
      <p>Neither is the better watch. They are made differently, which is why FALK classifies watches one at a time rather than brands. Two watches can also share an archetype without identical scores; the full profile explains the details.</p>
    </div>

    <div class="tile t-compare" id="compare">
      <h3 class="tile-h">Compare any two watches</h3>
      <form class="pickers" aria-label="Choose two watches">
        {[infinity, resurgence].map((sel, i) => (
          <label>
            <span class="sr-only">{i ? 'Second' : 'First'} watch</span>
            <select name={`w${i}`}>
              {comparable.map(r => <option value={r.id} selected={r.id === sel.id}>{r.brandName} {r.model}</option>)}
            </select>
          </label>
        ))}
      </form>
      <div class="scroll"><ProfileStrip caption="Profiles, side by side" marked={differ} columns={[
        { label: infinity.model, scores: infinity.profile.scores },
        { label: resurgence.model, scores: resurgence.profile.scores },
      ]} /></div>
      <dl class="compare-cls">
        {[infinity, resurgence].map(r => (
          <div><dt>{r.model}</dt><dd><span class="cls-name">{clsName(r)}</span> <ConfidenceMark grade={r.profile.confidence} /></dd></div>
        ))}
      </dl>
      <p class="compare-note" aria-live="polite">Same maker, different archetypes: {differ.length} of 7 measures differ.</p>
      <p class="small compare-links"><a href={recordUrl(infinity.id)}>{infinity.brandName} {infinity.model}</a><a href={recordUrl(resurgence.id)}>{resurgence.brandName} {resurgence.model}</a></p>
      <script type="application/json" id="compare-data" set:html={JSON.stringify(compareData)} />
    </div>
  </section>

  <section class="explore" aria-labelledby="explore-h">
    <div class="tile explore-search" data-rise>
      <h2 id="explore-h" class="sec-h">Explore the watches</h2>
      <form class="explore-form" action="/records/" method="get" role="search">
        <label for="explore-q">Search by brand, model, reference or caliber</label>
        <div class="explore-row">
          <input id="explore-q" name="q" type="search" placeholder="Try Tudor, 3861 or guilloché" />
          <button class="btn" type="submit">Search</button>
        </div>
      </form>
      <a href="/records/">Browse all {records.length} records</a>
      <figure class="explore-photo">
        <Picture src={img(photos.omega1861.src, 1600)} srcset={srcset(photos.omega1861)} sizes="(min-width: 1024px) 50vw, 100vw" width={photos.omega1861.w} height={photos.omega1861.h} alt={photos.omega1861.alt} loading="lazy" />
        <figcaption><a href={photos.omega1861.href}>{photos.omega1861.caption}</a></figcaption>
      </figure>
    </div>
    <nav class="tile explore-by" aria-labelledby="by-h" data-rise>
      <h3 id="by-h">By archetype</h3>
      <ul>
        {archetypes.map(a => (
          <li><a href={browseUrl(a.code)}><span>{a.name}</span><PatternStrip mini pattern={a.pattern} count={a.recs.length} caption="" /><span class="muted">{a.tagged}</span></a></li>
        ))}
      </ul>
    </nav>
  </section>

  <section class="open" aria-labelledby="open-h">
    <div class="tile open-lead" data-rise>
      <h2 id="open-h">Research you can check</h2>
      <p class="open-sentence">Every score opens to the claims and sources behind it. Records are corrected in public and every revision stays in their history. No paid placement, no sponsored scores.</p>
      <ul class="open-facts">
        <li><b data-roll={records.length}>{records.length}</b><span>records</span></li>
        <li><b data-roll={orgs.size}>{orgs.size}</b><span>makers and suppliers</span></li>
        <li><b data-roll={sources.size}>{sources.size}</b><span>sources, each archived</span></li>
        <li><b>CC BY-SA 4.0</b><span>data licence</span></li>
      </ul>
      <div class="actions">
        <a class="btn" href="/data/falk.csv">Download CSV</a>
        <a class="btn secondary" href="/data/falk.json">Download JSON</a>
        <a class="open-link" href="/data/schema.json">JSON Schema</a>
      </div>
    </div>
    <div class="tile open-data" id="open-data" data-ui>
      <div class="open-tabs" role="group" aria-label="Choose a record">
        {shown.map((r, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-i={i}>
            <span class="open-tab-name">{r.model}</span>
            <CompactStrip scores={r.profile.scores} />
          </button>
        ))}
      </div>
      {shown.map((r, i) => {
        const sourceCount = new Set(r.claims.map(c => c.source)).size;
        return (
          <article class="open-card" hidden={i !== 0} aria-label={`${r.brandName} ${r.model}`}>
            <header>
              <span class="small muted">{r.brandName}</span>
              <h3><a href={recordUrl(r.id)}>{r.model}</a></h3>
            </header>
            <ProfileStrip caption={`${r.model} profile`} columns={[{ scores: r.profile.scores }]} />
            <dl class="open-meta">
              <div><dt>Archetype</dt><dd><a href={archetypeUrl(r.profile.classification[0])}>{clsName(r)}</a></dd></div>
              <div><dt>Evidence</dt><dd><ConfidenceMark grade={r.profile.confidence} /></dd></div>
              <div><dt>Behind it</dt><dd>{r.claims.length} claims from {sourceCount} sources</dd></div>
            </dl>
            <p class="open-card-links"><a href={recordUrl(r.id)}>Open the record</a><a href={`/records/${r.id}.json`}>This record as JSON</a></p>
          </article>
        );
      })}
    </div>
    <figure class="tile research-photo">
      <Picture src={img(photos.angled.src, 1600)} srcset={srcset(photos.angled)} sizes="(min-width: 1024px) 50vw, 100vw" width={photos.angled.w} height={photos.angled.h} alt={photos.angled.alt} loading="lazy" />
      <figcaption><a href={photos.angled.href}>{photos.angled.caption}</a></figcaption>
    </figure>
    <div class="tile research-links" data-rise>
      <h3>How this was built</h3>
      <p>Every score uses methodology <a href="/methodology/">{methodology.code}</a>. The framework and reference dataset were developed in part with AI, which helped structure the method and compare edge cases; every profile is meant to be traceable to public sources.{provisional > 0 && ` ${provisional} ${provisional === 1 ? 'record is' : 'records are'} still provisional and marked in gilt.`}</p>
      <ul>
        <li><a href="/methodology/">Methodology</a></li>
        <li><a href="/sources/">Sources</a></li>
        <li><a href="/corrections/">Corrections</a></li>
        <li><a href="/about/">About the project</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero board: the name tile beside a real movement, under the 60px nav at 1440 × 900. It fills the screen, and
     grows past it when the heading (sized by width) needs more room, as on wide but short windows. */
  .board { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: minmax(max(560px, calc(100svh - 76px)), auto); gap: 8px; padding-top: 8px; }
  .tile { margin: 0; border-radius: var(--r-plate); background: var(--c-surface); overflow: hidden; }
  /* Not clipped: a clipped tile counts as zero height, so the row would not grow and the buttons were cut off. */
  .t-name { grid-column: 1 / 8; display: flex; flex-direction: column; justify-content: space-between; gap: var(--s-7); padding: var(--s-6); overflow: visible; }
  .display { font-size: clamp(48px, 6.4vw, 100px); line-height: 0.94; font-stretch: 70%; font-weight: 640; letter-spacing: -0.035em; max-width: 8em; }
  .t-name-head { display: grid; gap: var(--s-6); }
  .t-name-foot { display: grid; gap: var(--s-4); }
  .hero-lead { font-size: var(--t-lead); line-height: 1.4; letter-spacing: -0.012em; max-width: 44ch; }
  .hero-claim { font-size: var(--t-lead); line-height: 1.35; letter-spacing: -0.012em; max-width: 40ch; }
  .hero-claim b { font-weight: 620; }
  .t-name-foot .actions { margin-top: var(--s-3); }
  .movement { grid-column: 8 / 13; display: grid; grid-template-rows: minmax(0, 1fr) auto; background: #0E1726; }
  .m-stage { position: relative; overflow: hidden; }
  .m-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .m-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-2) var(--s-4); padding: var(--s-3) var(--s-4); background: var(--c-surface-2); font-size: 14px; color: var(--c-ink); }
  .m-bar a { font-weight: 560; }
  @media (prefers-reduced-motion: no-preference) {
    /* The tile opens like a shutter on load, then the photograph drifts slowly, as if under a loupe. */
    .m-stage { animation: shutter 1.1s var(--ease) both; }
    @keyframes shutter { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }
    .m-photo { animation: drift 24s ease-in-out 1.1s infinite alternate; }
    @keyframes drift { from { transform: scale(1); } to { transform: scale(1.06) translate(-1%, 1%); } }
  }

  /* One heading voice for every section. */
  .sec-h { font-size: var(--t-h2); line-height: 1.02; font-stretch: 74%; font-weight: 630; letter-spacing: -0.03em; max-width: 14em; }

  /* Seven measures: the explanation beside one real profile. */
  .how { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; margin-top: var(--s-9); }
  .how-text { grid-column: 1 / 8; display: flex; flex-direction: column; align-items: start; gap: var(--s-5); padding: var(--s-6); }
  .how-lead { font-size: var(--t-lead); line-height: 1.4; letter-spacing: -0.012em; max-width: 46ch; }
  .how-not { font-size: 18px; line-height: 1.45; max-width: 52ch; }
  .how-not b { font-weight: 620; }
  .how-text .btn { margin-top: auto; }
  .how-sample { grid-column: 8 / 13; display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-6) var(--s-5); background: var(--c-surface-2); }
  .how-sample :global(.strip caption) { font-size: 16px; }
  .how-sample :global(.strip td.name) { font-size: 14px; }
  .how-sample :global(.strip .seg) { width: 16px; height: 24px; }
  .how-key { margin-top: auto; }

  /* Archetypes: eight cards that select one panel. Without script every panel is shown in turn. */
  .arch { margin-top: var(--s-10); }
  .arch-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-5) var(--s-7); }
  /* Heading and lead on the left, the body on the right, both from the same top line, so neither side is left empty. */
  .arch-title { grid-column: 1 / 7; display: grid; align-content: start; gap: var(--s-5); }
  .arch-head .sec-h { max-width: 11em; }
  .arch-lead { font-size: var(--t-lead); line-height: 1.35; letter-spacing: -0.012em; max-width: 30ch; }
  .arch-intro { grid-column: 7 / 13; display: grid; align-content: start; gap: var(--s-4); padding-top: var(--s-2); font-size: 18px; line-height: 1.5; max-width: 56ch; }
  .arch-intro b { font-weight: 600; }
  .explorer { margin-top: var(--s-8); display: grid; gap: 8px; }
  .arch-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .arch-tabs button {
    display: flex; flex-direction: column; align-items: start; gap: var(--s-3); min-height: 196px; padding: var(--s-5); border: 0; border-radius: var(--r-plate);
    background: var(--c-surface); color: var(--c-ink); text-align: left; font: inherit; cursor: pointer;
    transition: background var(--d-quick) var(--ease), color var(--d-quick) var(--ease), transform var(--d-quick) var(--ease);
  }
  .arch-tabs button:hover { background: var(--c-surface-2); }
