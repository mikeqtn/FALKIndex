---
// Two to four watches side by side, chosen in the address (?w=a&w=b) so a comparison can be shared.
import Base from '../layouts/Base.astro';
import ProfileStrip from '../components/ProfileStrip.astro';
import ConfidenceMark from '../components/ConfidenceMark.astro';
import { DIMENSIONS, getCatalogue, recordUrl } from '../lib/data.ts';
import { MAX_COMPARE, compareQuery, pickCompared } from '../lib/compare.ts';
const { classification, records } = await getCatalogue(Astro.locals);

const { chosen, dropped } = pickCompared(Astro.url.searchParams, records);
const comparable = records.filter(r => r.profile.confidence !== 'D');
const differ = DIMENSIONS.filter(d => new Set(chosen.map(r => r.profile.scores[d].value)).size > 1);
const query = compareQuery(chosen.map(r => r.id));
const names = chosen.map(r => `${r.brandName} ${r.model}`);
const title = chosen.length >= 2 ? `Compare ${names.join(', ')}` : 'Compare watches';
// Pairs worth seeing, shown until two watches are chosen.
const suggestions = [
  ['jn-shapiro/infinity', 'jn-shapiro/resurgence', 'One maker, two routes'],
  ['grand-seiko/spring-drive-9r', 'grand-seiko/9f-quartz', 'Spring Drive against quartz'],
  ['tudor/black-bay-58', 'rolex/submariner-124060', 'Sister brands'],
  ['anordain/model-1-fabrik', 'anordain/model-2-porcelain', 'Enamel against a simpler dial'],
].map(([a, b, note]) => ({ note, rs: pickCompared(new URLSearchParams(compareQuery([a, b])), records).chosen }))
  .filter(s => s.rs.length === 2);
---
<Base
  title={title}
  description={chosen.length >= 2 ? `${names.join(', ')}, side by side on the FALK Index's seven measures.` : 'Compare two to four watches on the seven FALK measures, side by side.'}
  path={`/compare/${query ? `?${query}` : ''}`}
  image={chosen.length >= 2 ? { path: `/og/compare.png?${query}`, alt: `${names.join(', ')}, side by side on seven measures.` } : undefined}
>
  <header class="doc-head">
    <div>
      <h1>Compare</h1>
      <p class="lead">Up to {MAX_COMPARE} watches side by side. Darker means more of the work is done inside the brand; the scores are never added up.</p>
    </div>
    <form class="pickers" method="get" action="/compare/" aria-label="Choose watches to compare">
      {Array.from({ length: MAX_COMPARE }, (_, i) => (
        <label>
          <span class="sr-only">Watch {i + 1}</span>
          <select name="w">
            <option value="">{i < 2 ? 'Choose a watch' : 'Add a watch (optional)'}</option>
            {comparable.map(r => <option value={r.id} selected={chosen[i]?.id === r.id}>{r.brandName} {r.model}</option>)}
          </select>
        </label>
      ))}
      <button class="btn" type="submit">Compare</button>
    </form>
  </header>

  {dropped.length > 0 && (
    <p class="dropped small">Left out: {dropped.join(', ')}. Only records with a profile can be compared, up to {MAX_COMPARE} at a time.</p>
  )}

  {chosen.length >= 2 ? (
    <section class="result" aria-labelledby="result-h">
      <h2 id="result-h" class="sr-only">Profiles side by side</h2>
      <div class="plate scroll">
        <ProfileStrip caption="Profiles, side by side" animate marked={differ} columns={chosen.map(r => ({ label: r.model, scores: r.profile.scores }))} />
      </div>
      <p class="note" aria-live="polite">{differ.length === 0 ? 'The same on all seven measures.' : `${differ.length} of 7 measures differ.`}</p>
      <ul class="cards">
        {chosen.map(r => (
          <li>
            <span class="small muted">{r.brandName}</span>
            <a class="name" href={recordUrl(r.id)}>{r.model}</a>
            <span>{classification(r.profile.classification[0], r.profile.methodology).name}</span>
            <ConfidenceMark grade={r.profile.confidence} />
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="start" aria-labelledby="start-h">
      <h2 id="start-h">{chosen.length === 1 ? `Choose another watch to set beside the ${names[0]}` : 'Or start from one of these'}</h2>
      <ul class="pairs">
        {suggestions.map(s => (
          <li><a href={`/compare/?${compareQuery(s.rs.map(r => r.id))}`}><b>{s.rs.map(r => `${r.brandName} ${r.model}`).join(' and ')}</b><span class="small muted">{s.note}</span></a></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .doc-head h1 { font-size: clamp(56px, 6vw, 96px); }
  .pickers { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-2); align-self: end; }
  .pickers select { width: 100%; }
  .pickers .btn { grid-column: 1 / -1; justify-self: start; }
  :global(.js-compare) .pickers .btn { display: none; }
  .dropped { margin-bottom: var(--s-5); padding: var(--s-3) var(--s-4); background: var(--c-surface); border-radius: var(--r-control); overflow-wrap: anywhere; }
  .result .plate { padding: var(--s-5); }
  /* Rows that differ keep their marked edge; the word "changed" belongs to version history, not comparisons. */
  .result :global(.strip td.name .small) { display: none; }
  .note { margin-top: var(--s-4); font-size: var(--t-lead); letter-spacing: -0.012em; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 4px; margin: var(--s-6) 0 0; padding: 0; list-style: none; }
  .cards li { display: grid; gap: var(--s-2); align-content: start; padding: var(--s-4) var(--s-5); background: var(--c-surface); border-radius: var(--r-plate); }
  .cards .name { font-size: 20px; font-weight: 600; }
  .start h2 { font-size: clamp(28px, 2.8vw, 40px); line-height: 1.05; font-stretch: 74%; font-weight: 630; letter-spacing: -0.025em; margin-bottom: var(--s-5); }
  .pairs { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 4px; margin: 0; padding: 0; list-style: none; }
  .pairs a { display: grid; gap: var(--s-1); height: 100%; padding: var(--s-4) var(--s-5); background: var(--c-surface); border-radius: var(--r-plate); color: var(--c-ink); text-decoration: none; transition: background var(--d-quick) var(--ease); }
  .pairs a:hover { background: var(--c-surface-2); }
  .pairs b { font-size: 18px; font-weight: 600; }
  @media (max-width: 639px) { .pickers { grid-template-columns: 1fr; } .result .plate { padding: var(--s-3); } }
  /* On a phone all columns share the width, so four watches fit without scrolling sideways. */
  @media (max-width: 639px) {
    .result :global(.strip.multi tr) { grid-template-columns: 2.4em repeat(var(--cols), minmax(0, 1fr)); }
    .result :global(.strip.multi thead th) { font-size: 12px; line-height: 1.2; padding-right: 4px; overflow-wrap: anywhere; }
    .result :global(.strip .segs) { gap: 2px; }
    .result :global(.strip .seg) { width: 8px; height: 20px; }
    .result :global(.strip .num) { margin-left: 4px; font-size: 16px; }
    .result :global(.strip td.v) { padding-right: 4px; }
  }
</style>

<script>
  // With script, a new choice loads straight away; without it, the Compare button submits the form.
  const form = document.querySelector<HTMLFormElement>('.pickers')!;
  document.documentElement.classList.add('js-compare');
  form.addEventListener('change', () => {
    const ids = [...new Set([...form.querySelectorAll('select')].map(s => s.value).filter(Boolean))];
    location.href = `/compare/${ids.length ? `?${ids.map(id => `w=${encodeURIComponent(id)}`).join('&')}` : ''}`;
  });
</script>
