---
import { execSync } from 'node:child_process';
import Base from '../../layouts/Base.astro';
import { fmtDate, records, url } from '../../lib/data.ts';

const commit = (() => { try { return execSync('git rev-parse --short HEAD').toString().trim(); } catch { return ''; } })();
const built = new Date().toISOString().slice(0, 10);
---
<Base title="Data" nav="data" description="Download the full FALK Index dataset as JSON or CSV.">
  <header class="page-head">
    <h1>Data</h1>
    <p class="lead">The full dataset is open. Use it, check it, build on it.</p>
  </header>

  <div class="prose sections">
    <h2>Full dataset</h2>
    <ul>
      <li><a href={url("/data/falk.json")}>Download JSON</a>: all {records.length} records with provenance, claims and every profile version, plus organizations, sources and the methodology.</li>
      <li><a href={url("/data/falk.csv")}>Download CSV</a>: one row per record with its current profile, classification and evidence grade. An unknown (U) score is an empty cell with a matching <code>_unknown</code> flag.</li>
    </ul>
    <p class="small">Built {fmtDate(built)}{commit && <> from commit <a href={`https://github.com/mikeqtn/FALKIndex/commit/${commit}`}>{commit}</a></>}.</p>

    <h2>Single records</h2>
    <p>Every record has a JSON link at the bottom of its page, for example <a href={url("/records/jn-shapiro/resurgence.json")}>/records/jn-shapiro/resurgence.json</a>.</p>

    <h2>Schema</h2>
    <p>Records follow a published <a href={url("/data/schema.json")}>JSON Schema</a>, generated from the same definitions that validate the data.</p>

    <h2>Licence</h2>
    <p>Data: CC BY-SA 4.0. Code: MIT.</p>
  </div>
</Base>

<style>
  .sections h2 { margin-top: var(--s-7); font-size: 28px; line-height: 32px; }
  code { font-size: 0.9em; }
</style>
