---
import ForumLayout from '../../layouts/ForumLayout.astro';
import ThreadList from '../../components/forum/ThreadList.astro';
import { searchForum, searchQuery } from '../../../server/forum.ts';
const asked = Astro.url.searchParams.get('q') ?? '';
const query = searchQuery.safeParse({ q:asked });
const threads = query.success ? await searchForum(query.data.q) : [];
---
<ForumLayout title="Search the forum" description="Search thread titles and posts on the FALK Forum.">
  <header class="f-title"><div><h1>Search the forum</h1></div></header>
  <form class="f-search-page" method="get" role="search">
    <label class="sr-only" for="forum-q">Search the forum</label>
    <input id="forum-q" type="search" name="q" value={asked} placeholder="Words in titles and posts" minlength="2" maxlength="200" required />
    <button class="f-button" type="submit">Search</button>
  </form>
  {query.success && <ThreadList threads={threads} heading={`${threads.length} ${threads.length === 1 ? 'thread' : 'threads'} matching “${query.data.q}”`} empty={`No threads match “${query.data.q}”.`} />}
</ForumLayout>
