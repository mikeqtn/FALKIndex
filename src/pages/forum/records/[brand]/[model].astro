---
import ForumLayout from '../../../../layouts/ForumLayout.astro';
import CompactStrip from '../../../../components/CompactStrip.astro';
import ThreadList from '../../../../components/forum/ThreadList.astro';
import { recordThreads } from '../../../../../server/forum.ts';
import { getCatalogue } from '../../../../lib/data.ts';
import { forumPath, siteHref } from '../../../../lib/forum.ts';
// The FALK Index Discussion category (scripts/forum-seed.ts) is where record threads start.
const RECORD_CATEGORY = 'falk-index';
const { records } = await getCatalogue(Astro.locals);
const r = records.find(r => r.id === `${Astro.params.brand}/${Astro.params.model}`);
if (!r) return Astro.rewrite('/forum/not-found/');
const threads = await recordThreads(r.id);
const name = `${r.brandName} ${r.model}`;
---
<ForumLayout nav={RECORD_CATEGORY} title={`Discussing ${name}`} description={`Forum threads about the FALK Index record for the ${name}.`}>
  <header class="f-title">
    <div>
      <p class="f-crumb"><a href={forumPath(`/${RECORD_CATEGORY}/`)}>FALK Index Discussion</a></p>
      <h1>Discussing the {name}</h1>
      <p class="f-thread-record"><CompactStrip scores={r.profile.scores} /><a href={siteHref(`/records/${r.id}/`)}>Read the record and its evidence</a></p>
    </div>
    <a class="f-button" href={forumPath(`/new/?category=${RECORD_CATEGORY}&record=${encodeURIComponent(r.id)}`)} data-needs-account>Start a thread about it</a>
  </header>
  <ThreadList threads={threads} hideRecord empty="No one has discussed this record yet." />
</ForumLayout>
