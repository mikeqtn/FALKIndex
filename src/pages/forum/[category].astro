---
import ForumLayout from '../../layouts/ForumLayout.astro';
import ThreadBrowser from '../../components/forum/ThreadBrowser.astro';
import { listQuery, listThreads } from '../../../server/forum.ts';
import { forumPath } from '../../lib/forum.ts';
const id = Astro.params.category ?? '';
const query = listQuery.safeParse({ page:Astro.url.searchParams.get('page') ?? undefined, sort:Astro.url.searchParams.get('sort') ?? undefined });
const listing = /^[a-z0-9]+(-[a-z0-9]+)*$/.test(id) && query.success ? await listThreads(id, query.data.page, query.data.sort) : null;
if (!listing || !query.success) return Astro.rewrite('/forum/not-found/');
---
<ForumLayout nav={id} title={listing.category.name} description={listing.category.description}>
  <header class="f-title">
    <div>
      <a class="f-back" href={forumPath('/')}>Back to forum home</a>
      <h1>{listing.category.name}</h1>
      <p class="f-lead">{listing.category.description}</p>
    </div>
    <a class="f-button" href={forumPath(`/new/?category=${id}`)}>Start a thread</a>
  </header>
  <ThreadBrowser listing={listing} sort={query.data.sort} empty="No threads here yet. Start the first one." />
</ForumLayout>
