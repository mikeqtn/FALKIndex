---
import ForumLayout from '../../layouts/ForumLayout.astro';
import ModerationApp from '../../components/forum/ModerationApp.tsx';
import { forumLinks, signInHref } from '../../lib/forum.ts';
---
<ForumLayout title="Reports">
  <header class="f-title"><div><h1>Reports</h1><p class="f-lead">Open reports, oldest first. Hiding a post needs a reason, and nothing is deleted.</p></div></header>
  <ModerationApp client:only="react" links={forumLinks()} signInHref={signInHref(Astro.url.pathname)} />
</ForumLayout>
