---
import Base from '../../../layouts/Base.astro';
import ProfileStrip from '../../../components/ProfileStrip.astro';
import ConfidenceMark from '../../../components/ConfidenceMark.astro';
import ProvisionalBanner from '../../../components/ProvisionalBanner.astro';
import EvidenceList from '../../../components/EvidenceList.astro';
import Picture from '../../../components/Picture.astro';
import { WATCH_PHOTOS } from '../../../lib/watch-photos.ts';
import {
  DIMENSIONS, RELATIONSHIP, orgUrl, getCatalogue, correctionUrl, editorName, fmtDate, recordUrl, siteOrigin,
} from '../../../lib/data.ts';
import { forumHref } from '../../../lib/forum.ts';
import { recordThreadCount } from '../../../../server/forum.ts';
import { ARCHETYPES, DESCRIPTOR, archetypeUrl } from '../../../lib/archetypes.ts';

const { classification, dimension, orgs, records } = await getCatalogue(Astro.locals);
const r = records.find(r => r.id === `${Astro.params.brand}/${Astro.params.model}`);
if (!r) return new Response('Record not found',{status:404});
const p = r.profile;
// The thread count is live forum data, not part of the cached catalogue. If the database is unavailable the record
// still renders from the last good catalogue, with the discussion link but no count.
const discussions = await recordThreadCount(r.id);
const noProfile = p.confidence === 'D';
const details = [
  ['Generation', r.generation], ['Reference', r.reference], ['Caliber', r.caliber], ['Production route', r.route_label],
  ['Made', r.production_start && `${r.production_start} to ${r.production_end ?? 'present'}`],
].filter(([, v]) => v) as [string, string | number][];
const photos = WATCH_PHOTOS[r.id] ?? {};
const sides = (['front', 'back'] as const).filter(side => photos[side]);
const sideName = { front: 'Front', back: 'Back' };
const origin = siteOrigin(Astro.url);
const crumbs = [['Records', '/records/'], [r.brandName, orgUrl(r.brand)], [r.model, recordUrl(r.id)]];
const photoSrc = (side: string, w: 600 | 1200) => `/images/watches/${r.id}/${side}-${w}.jpg`;
// Who makes it, at a glance (records without a photo): the provenance grouped by maker and relationship, the brand's
// own work first and unnamed makers last. Kept short for the left column; every entry is in full in its panel.
const REL_ORDER = Object.keys(RELATIONSHIP);
const glance = [...r.provenance.reduce((by, e) => {
  const key = `${e.performer ?? ''}|${e.relationship}`;
  const g = by.get(key) ?? { performer: e.performer, relationship: e.relationship, parts: [] as string[] };
  const part = e.component.replace(/\s*\([^)]*\)/g, ''); // "Case (904L steel, 41 mm)" reads "Case" here
  if (!g.parts.includes(part)) g.parts.push(part);
  return by.set(key, g);
}, new Map<string, { performer?: string; relationship: keyof typeof RELATIONSHIP; parts: string[] }>()).values()]
  .sort((a, b) => Number(!a.performer) - Number(!b.performer) || Number(b.performer === r.brand) - Number(a.performer === r.brand)
    || REL_ORDER.indexOf(a.relationship) - REL_ORDER.indexOf(b.relationship) || b.parts.length - a.parts.length);
const GLANCE_MAX = 3;
---
<Base
  title={`${r.brandName} ${r.model}`}
  description={`FALK profile and provenance evidence for the ${r.brandName} ${r.model}.`}
  image={{ path: `/og/records/${r.id}.png`, alt: `FALK profile of the ${r.brandName} ${r.model}: seven dimensions scored 0 to 5.` }}
  ld={{ '@type': 'BreadcrumbList', itemListElement: crumbs.map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${origin}${path}` })) }}
>
  {p.is_seed && <ProvisionalBanner slot="banner" />}

  <header class="page-head app-head rec-head">
    <div class="rec-title">
      <a class="brand-link" href={orgUrl(r.brand)}>{r.brandName}</a>
      <h1>{r.model}</h1>
      {details.length > 0 && <dl class="pairs small">{details.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
    </div>
    <div class="actions rec-actions">
      <a class="btn" href={correctionUrl(r.id)}>Send a correction</a>
      <a href={forumHref(`/records/${r.id}/`)}>Discuss this record{discussions ? ` (${discussions})` : ''}</a>
      <a href={`/records/${r.id}.json`}>Download JSON</a>
    </div>
    <nav class="rec-nav" aria-label="Sections of this record">
      {!noProfile && <a href="#profile">Profile</a>}
      <a href="#evidence">Evidence</a>
      <a href="#history">History</a>
    </nav>
  </header>

  {/* One grid for everything below the header: the profile picker on the left; the summary band, the evidence, the
      history and the closing note in the main column. On wide screens the picker's rows choose the evidence panel
      (EvidenceList's script). Narrow screens stack it all in one column with the summary first. */}
  <div class="rec-grid">
    <div class="rec-side">
      {noProfile
        ? (
          <div class="rec-pick" data-picker>
            <div class="no-profile"><p>Not enough evidence for a profile yet. Who makes each part is listed in each dimension's evidence.</p></div>
            <nav class="plate dim-list" aria-label="Dimensions">
              <ol>{DIMENSIONS.map(d => <li><a href={`#evidence-${d.toLowerCase()}`}><span class="dim-code">{d}</span><span>{dimension[d].label}</span></a></li>)}</ol>
            </nav>
          </div>
        )
        : (
          <div class="plate scroll profile-plate rec-pick" id="profile" data-picker>
            <ProfileStrip caption="Profile" columns={[{ scores: p.scores }]} linkRows />
            <p class="small muted">Not a ranking: darker means more of the work happens inside the brand. Select a measure to read its evidence.</p>
          </div>
        )}
      {/* The specimen card, under the picker and sticking with it: the watch's photos, or, with none, who makes it. */}
      {sides.length > 0
        ? (
          <section class:list={['plate specimen photos', { one: sides.length === 1 }]} aria-label="Photographs of this watch">
            <ul class="thumbs">
              {sides.map(side => {
                const ph = photos[side]!;
                return (
                  <li>
                    <a class="thumb" href={photoSrc(side, 1200)} data-photo={`photo-${side}`} aria-haspopup="dialog">
                      <Picture src={photoSrc(side, 600)} srcset={`${photoSrc(side, 600)} ${Math.min(600, ph.w)}w`} sizes="(min-width: 1024px) 360px, 120px" width={ph.w} height={ph.h} alt={`${sideName[side]}, enlarge: ${ph.alt}`} loading="lazy" />
                    </a>
                    <p class="credit"><b>{sideName[side]}</b> {ph.credit.replace(/, via .*/, '')}, <a href={ph.licenceUrl}>{ph.licence}</a>{ph.cropped && ', cropped'}</p>
                  </li>
                );
              })}
            </ul>
            {sides.map(side => {
              const ph = photos[side]!;
              return (
                <dialog class="photo-dialog" id={`photo-${side}`} aria-label={`${sideName[side]} of the ${r.brandName} ${r.model}`}>
                  <div class="pd-body">
                    <Picture src={photoSrc(side, 1200)} srcset={`${photoSrc(side, 1200)} ${ph.w}w`} sizes="min(92vw, 1200px)" width={ph.w} height={ph.h} alt={ph.alt} loading="lazy" />
                    <p class="small"><b>{sideName[side]}</b> Photo by {ph.credit}, <a href={ph.licenceUrl}>{ph.licence}</a>, {ph.cropped ? 'cropped and resized' : 'resized'}. <a href={ph.source}>Original</a></p>
                    <form method="dialog"><button class="btn secondary" type="submit">Close</button></form>
                  </div>
                </dialog>
              );
            })}
          </section>
        )
        : (
          <section class="plate specimen glance" aria-labelledby="glance-h">
            <h2 class="glance-h" id="glance-h">Who makes it, at a glance</h2>
            {glance.length > 0 && (
              <ul class="glance-list">
                {glance.slice(0, GLANCE_MAX).map(g => (
                  <li>
                    <span class="g-by">{g.performer ? <a href={orgUrl(g.performer)}>{orgs.get(g.performer)!.name}</a> : <span class="muted">Not named</span>}</span>
                    <span class:list={['rel', g.relationship]}><span>{RELATIONSHIP[g.relationship]}</span></span>
                    <span class="g-parts"><span class="g-list">{g.parts.join(', ')}</span>{g.parts.length > 1 && <span class="g-n">{g.parts.length} parts</span>}</span>
                  </li>
                ))}
              </ul>
            )}
            {glance.length > GLANCE_MAX && <p class="g-more"><a href="#evidence">{glance.length - GLANCE_MAX} more in the evidence</a></p>}
            <p class="g-photo">No licensed photo of this watch yet. <a href={correctionUrl(r.id)}>Send one with a correction</a>.</p>
          </section>
        )}
    </div>

    <div class="rec-main">
      {/* A short band: the verdict and its notes on the left, the facts on the right, so all of it is on the first
          screen beside the picker. */}
      <aside class="plate summary" aria-label="Summary">
        <div class="sum-lead">
        {!noProfile && (
          <div class="cls-block">
            <h2 class="cls"><a href={archetypeUrl(p.classification[0])}>{classification(p.classification[0], p.methodology).name}</a></h2>
            {p.classification.slice(1).map(c => <p class="muted">with <a href={archetypeUrl(c)}>{classification(c, p.methodology).name}</a> traits</p>)}
            {ARCHETYPES[p.classification[0]] && <p class="cls-short">{ARCHETYPES[p.classification[0]].short}</p>}
          </div>
        )}
        {p.independent_watchmaker && <p class="iw">Independent watchmaker: an identifiable watchmaker personally performs substantial watchmaking and craft on these watches. <a href={archetypeUrl(DESCRIPTOR.code)}>About this descriptor</a></p>}
        {/* Right of reply: on every record, profile or not (site.test.ts checks it). */}
        <p class="small muted">Based on the cited sources below, not on FALK's own inspection. Brands can <a href={correctionUrl(r.id)}>reply with evidence here</a>.</p>
        </div>
        <dl class="facts">
          <div><dt>Evidence</dt><dd><ConfidenceMark grade={p.confidence} /></dd></div>
          <div><dt>Version</dt><dd>{p.version} · {fmtDate(p.created_on)}</dd></div>
          <div><dt>Scored with</dt><dd><a href="/methodology/">Methodology {p.methodology}</a></dd></div>
        </dl>
      </aside>

      <section class="block evidence-section" id="evidence">
        <div class="h2-row">
          <h2>Evidence by dimension</h2>
          <button class="btn secondary" type="button" id="open-all" hidden>Open all</button>
        </div>
        <EvidenceList profile={p} record={r} idPrefix="evidence" />
      </section>
    </div>
  </div>

  {/* The grid ends with the evidence; the draft, the history and the note read below it at a reading width. */}
  <div class="rec-after">

      {r.draft && (
        <section class="block" id="draft">
          <h2>Draft under review</h2>
          <div class="provisional draft-note" role="note">
            <p><b>Version {r.draft.version} has not been checked by an editor yet.</b> It does not change the published profile above until it is approved.</p>
            <p class="small">{r.draft.change_note}</p>
          </div>
          <div class="plate scroll">
            <ProfileStrip caption="Published and draft profiles" columns={[
              { label: `Published, version ${p.version}`, scores: p.scores },
              { label: `Draft, version ${r.draft.version}`, scores: r.draft.scores },
            ]} />
          </div>
          <h3 class="draft-h">Draft evidence by dimension</h3>
          <EvidenceList profile={r.draft} record={r} idPrefix="draft-evidence" />
        </section>
      )}

      <section class="block" id="history">
        <h2>History</h2>
        {(() => {
          const entry = (v: typeof p) => {
            const prev = r.profiles.find(x => x.version === v.version - 1);
            const dims = prev ? DIMENSIONS.filter(d => prev.scores[d].value !== v.scores[d].value) : [];
            const changes = prev ? [
              ...dims.map(d => `${d} ${prev.scores[d].value ?? 'U'} → ${v.scores[d].value ?? 'U'}`),
              ...(prev.confidence !== v.confidence ? [`evidence ${prev.confidence} → ${v.confidence}`] : []),
              ...(prev.classification.join() !== v.classification.join() ? ['classification'] : []),
            ] : [];
            return (
              <li>
                <p><b>Version {v.version}</b> <span class="small">{fmtDate(v.created_on)}, {editorName(v.editor)}</span>{v.status !== 'published' && <span class="small muted"> ({v.status})</span>}</p>
                {prev && <p class="small">{changes.length ? `Changed from version ${prev.version}: ${changes.join(', ')}.` : `No changes to scores, evidence grade or classification from version ${prev.version}.`}</p>}
                <p class="prose">{v.change_note}</p>
                {prev && (
                  <details class="compare">
                    <summary>Compare with version {prev.version}</summary>
                    <div class="plate scroll">
                      <ProfileStrip caption={`Version ${prev.version} and version ${v.version}`} marked={dims} columns={[
                        { label: `Version ${prev.version}`, scores: prev.scores },
                        { label: `Version ${v.version}`, scores: v.scores },
                      ]} />
                    </div>
                  </details>
                )}
              </li>
            );
          };
          const [latest, ...earlier] = [...r.profiles].reverse();
          return (
            <>
              <ol class="history">{entry(latest)}</ol>
              {earlier.length > 0 && (
                <details class="earlier">
                  <summary>Earlier versions ({earlier.length})</summary>
                  <ol class="history">{earlier.map(entry)}</ol>
                </details>
              )}
            </>
          );
        })()}
      </section>

      {r.notes && <p class="rec-close small muted">{r.notes}</p>}
  </div>
</Base>

<style>
  .scroll { overflow-x: auto; }
  /* Header: the watch on the left, the two things a reader does on the right, then the section links under both. */
  .rec-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--s-4) var(--s-6); padding: var(--s-7) 0 var(--s-5); }
  .rec-head > * + * { margin-top: 0; }
  .rec-title > * + * { margin-top: var(--s-2); }
  .rec-head h1 { font-size: 40px; }
  .rec-actions { justify-content: flex-end; }
  .rec-nav { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0 var(--s-5); padding-top: var(--s-3); border-top: 1px solid color-mix(in srgb, var(--c-edge) 55%, transparent); }
  .rec-nav a { display: inline-flex; align-items: center; min-height: 40px; font-size: 15px; color: var(--c-ink-2); text-decoration: none; }
  .rec-nav a:hover { color: var(--c-ink); }
  @media (max-width: 639px) {
    .rec-head { grid-template-columns: 1fr; align-items: start; }
    .rec-actions { justify-content: flex-start; }
  }
  .brand-link { display: inline-block; padding: 12px 0; margin: -12px 0; font-size: 15px; font-weight: 500; text-decoration: none; }
  .brand-link:hover { text-decoration: underline; }
  /* One grid below the header (DESIGN.md §5.3): a 380px left column and the main column, one gap and one set of edges
     for every section. Narrow screens stack it: summary, profile, evidence, history, closing note. */
  .rec-grid { display: grid; gap: var(--s-4); }
  .rec-side { display: flex; flex-direction: column; gap: var(--s-4); min-width: 0; }
  .rec-main { min-width: 0; }
  /* Narrow: the two columns dissolve into one stack: photos (when there are any), summary, profile, who makes it
     (when there are none), evidence. The markup has the picker first for wide screens. */
  @media (max-width: 1023px) {
    .rec-side, .rec-main { display: contents; }
    .rec-main > .summary { order: -1; }
    .rec-side > .photos { order: -2; }
  }
  @media (min-width: 1024px) {
    .rec-grid { grid-template-columns: 380px minmax(0, 1fr); gap: var(--s-5); }
    /* The summary is a short band above the evidence: the verdict and its notes beside the facts. */
    .rec-main > .summary { grid-template-columns: minmax(0, 1fr) 300px; gap: var(--s-6); align-items: start; margin-bottom: var(--s-5); }
    .rec-main > .evidence-section { padding-top: 0; }
    /* Beside the picker the panel's own heading names the dimension; the section heading stays for assistive tech. */
    .evidence-section .h2-row { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  /* The picker and the specimen card stick together, and only when the screen is tall enough to keep both whole. */
  @media (min-width: 1024px) and (min-height: 900px) {
    .rec-side { position: sticky; top: calc(var(--nav-h) + var(--s-4)); align-self: start; }
  }
  /* The specimen card. With photos: front and back as square thumbnails (one photo spans the card), each opening
     the full photo and its credit in a dialog. Without: who makes it, grouped by maker, and the photo invitation. */
  .specimen { display: grid; gap: var(--s-4); padding: var(--s-4); }
  .thumbs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); margin: 0; padding: 0; list-style: none; }
  .one .thumbs { grid-template-columns: minmax(0, 1fr); }
  .thumbs li { display: grid; gap: var(--s-2); align-content: start; min-width: 0; }
  .thumb { display: block; border-radius: var(--r-control); overflow: hidden; background: var(--c-surface-sunk); cursor: zoom-in; }
  .thumb img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; transition: transform var(--d-open) var(--ease); }
  .one .thumb img { aspect-ratio: 3 / 2; }
  .thumb:hover img { transform: scale(1.03); }
  .thumb:focus-visible { outline-offset: 3px; }
  .credit { font-size: 13px; line-height: 1.4; color: var(--c-ink-2); text-wrap: pretty; }
  .credit b { margin-right: var(--s-1); font-weight: 600; color: var(--c-ink); }
  .credit a, .pd-body p a { white-space: nowrap; }
  .glance-h { font-size: 16px; line-height: 1.3; font-weight: 600; }
  .glance-list { margin: 0; padding: 0; list-style: none; }
  .glance-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px var(--s-3); align-items: center; padding-block: var(--s-2); border-top: 1px solid color-mix(in srgb, var(--c-edge) 55%, transparent); }
  .glance-list li:last-child { border-bottom: 1px solid color-mix(in srgb, var(--c-edge) 55%, transparent); }
  .g-by { font-size: 15px; font-weight: 560; min-width: 0; }
  .g-by a { color: var(--c-ink); text-decoration: none; }
  .g-by a:hover { color: var(--c-action); text-decoration: underline; }
  .glance-list .rel { font-size: 12px; padding-block: 1px; }
  /* One line of parts per maker: the list is cut with an ellipsis, the count stays whole (all of it is in the panels). */
  .g-parts { grid-column: 1 / -1; display: flex; gap: var(--s-2); min-width: 0; font-size: 13px; line-height: 1.4; color: var(--c-ink-2); }
  .g-list { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .g-n { flex: none; margin-left: auto; font-variant-numeric: tabular-nums; }
  .g-more, .g-photo { font-size: 13px; line-height: 1.45; color: var(--c-ink-2); text-wrap: pretty; }
  .g-more { margin-top: calc(-1 * var(--s-2)); }
  /* The full photo over a dimmed page; Esc, the Close button or a click outside closes it. */
  .photo-dialog { width: fit-content; max-width: 92vw; max-height: 92vh; padding: 0; border: 0; border-radius: var(--r-plate); background: var(--c-surface); color: var(--c-ink); box-shadow: 0 24px 64px rgb(0 0 0 / .35); }
  .photo-dialog::backdrop { background: rgb(8 12 20 / .78); }
  .pd-body { display: grid; gap: var(--s-3); padding: var(--s-3) var(--s-3) var(--s-4); }
  .pd-body img { display: block; width: auto; max-width: min(100%, 1200px); height: auto; max-height: calc(92vh - 120px); object-fit: contain; border-radius: var(--r-control); background: var(--c-surface-sunk); }
  .pd-body p { width: 0; min-width: 100%; box-sizing: border-box; padding-inline: var(--s-2); color: var(--c-ink-2); text-wrap: pretty; }
  .pd-body p b { margin-right: var(--s-1); color: var(--c-ink); }
  .pd-body form { display: flex; justify-content: flex-end; padding-inline: var(--s-2); }
  html:has(.photo-dialog[open]) { overflow: hidden; }
  @media (prefers-reduced-motion: no-preference) {
    .photo-dialog[open] { animation: pd-in var(--d-open) var(--ease); }
    .photo-dialog[open]::backdrop { animation: pd-fade var(--d-open) var(--ease); }
  }
  @media (prefers-reduced-motion: reduce) { .thumb img { transition: none; } .thumb:hover img { transform: none; } }
  @keyframes pd-in { from { opacity: 0; transform: translateY(6px) scale(.98); } }
  @keyframes pd-fade { from { opacity: 0; } }
  /* Phones and tablets: the photos are a compact row of small thumbnails under the header. */
  @media (max-width: 1023px) {
    .photos { padding: var(--s-3); }
    .thumbs, .one .thumbs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .thumbs li { grid-template-columns: 64px minmax(0, 1fr); align-items: center; gap: var(--s-3); }
    .one .thumb img { aspect-ratio: 1; }
  }
  .profile-plate { display: grid; gap: var(--s-4); }
  /* The profile as the picker: the selected row raised, its name underlined with the ruby selection line. */
  @media (min-width: 1024px) {
    .profile-plate { padding: var(--s-5) var(--s-2) var(--s-4); }
    .profile-plate > p, .profile-plate :global(caption) { padding-inline: var(--s-3); }
    .profile-plate :global(.strip) { width: 100%; }
    .profile-plate :global(.strip th[scope="row"]) { padding-left: var(--s-3); }
    .profile-plate :global(.strip .seg) { width: 14px; }
    .profile-plate :global(.strip td.v) { padding-right: var(--s-3); }
    .profile-plate :global(.strip td.name) { font-size: 15px; line-height: 1.25; }
    .profile-plate :global(tr.link > *) { transition: background var(--d-quick) var(--ease); }
    .profile-plate :global(tr.link > :first-child) { border-radius: var(--r-control) 0 0 var(--r-control); }
    .profile-plate :global(tr.link > :last-child) { border-radius: 0 var(--r-control) var(--r-control) 0; }
    .profile-plate :global(tr.link:hover > *) { background: color-mix(in srgb, var(--c-ink) 5%, var(--c-surface)); }
    .profile-plate :global(tr.link:has(a[aria-current]) > *) { background: color-mix(in srgb, var(--c-ink) 10%, var(--c-surface)); }
    .profile-plate :global(tr.link a[aria-current]) { font-weight: 560; text-decoration: underline 2px var(--c-action); text-underline-offset: 5px; }
  }
  /* Confidence D: no bars to draw, so the picker is the seven names. Phones read them as the accordion's headings. */
  .rec-pick:not(.profile-plate) { display: grid; gap: var(--s-4); }
  .dim-list { padding: var(--s-2); }
  .dim-list ol { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .dim-list a { display: grid; grid-template-columns: 2.4em minmax(0, 1fr); align-items: center; min-height: 44px; padding: var(--s-2) var(--s-3); border-radius: var(--r-control); font-size: 15px; color: var(--c-ink); text-decoration: none; transition: background var(--d-quick) var(--ease), color var(--d-quick) var(--ease); }
  .dim-list a:hover { background: color-mix(in srgb, var(--c-ink) 5%, var(--c-surface)); color: var(--c-action); }
  .dim-list a[aria-current] { background: color-mix(in srgb, var(--c-ink) 10%, var(--c-surface)); font-weight: 560; }
  .dim-list a[aria-current] span:last-child { text-decoration: underline 2px var(--c-action); text-underline-offset: 5px; }
  .dim-code { font: 700 18px/1 var(--f-sans); font-stretch: 62%; }
  @media (max-width: 1023px) { .dim-list { display: none; } }
  .summary { display: grid; align-content: start; gap: var(--s-5); }
  .sum-lead { display: grid; gap: var(--s-3); align-content: start; }
  .sum-lead p, .history p, .draft-note p { text-wrap: pretty; }
  .cls { font-size: 28px; line-height: 1.15; font-stretch: 84%; }
  .cls a { color: var(--c-ink); text-decoration: none; }
  .cls a:hover { color: var(--c-action); text-decoration: underline; }
  .cls-short { font-size: 16px; line-height: 1.45; }
  .cls-block > * + * { margin-top: var(--s-1); }
  .iw { font-size: 15px; line-height: 1.5; padding: var(--s-3) var(--s-4); border-radius: var(--r-control); background: var(--c-surface-2); }
  .facts { display: grid; gap: 0; margin: 0; }
  .facts div { display: grid; grid-template-columns: 6.5em 1fr; gap: var(--s-3); align-items: center; min-height: 44px; border-top: 1px solid color-mix(in srgb, var(--c-edge) 55%, transparent); }
  .facts dt { font-size: 14px; color: var(--c-ink-2); }
  .facts dd { margin: 0; font-size: 15px; }
  @media (min-width: 1024px) { #open-all { display: none; } }
  .h2-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3); margin-bottom: var(--s-5); }
  .history { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .history li > * + * { margin-top: var(--s-2); }
  .compare summary { cursor: pointer; color: var(--c-action); min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 3px; }
  .compare[open] summary { margin-bottom: var(--s-3); }
  .earlier { margin-top: var(--s-5); }
  .earlier > summary { cursor: pointer; display: inline-flex; align-items: center; min-height: 44px; font-weight: 560; color: var(--c-ink); }
  .earlier[open] > summary { margin-bottom: var(--s-4); }
  /* Below the grid: the draft, History and the note at a reading width on the page's left edge. */
  .rec-after { max-width: 56rem; margin-top: var(--s-8); }
  .rec-after > .block:first-child { padding-top: 0; }
  .rec-close { margin-top: var(--s-8); max-width: var(--measure); text-wrap: pretty; }
  .draft-note { padding: var(--s-4) var(--s-5); margin-bottom: var(--s-5); max-width: var(--measure); }
  .draft-note > * + * { margin-top: var(--s-2); }
  .draft-h { margin: var(--s-6) 0 var(--s-4); }
</style>

<script>
  // The picked panel is at least as tall as the left column (global.css reads --side-h), so the page below it holds
  // still when the reader switches between a short panel and a long one.
  const grid = document.querySelector<HTMLElement>('.rec-grid')!;
  const side = [...document.querySelectorAll<HTMLElement>('.rec-side > *')];
  const measure = () => {
    const gap = parseFloat(getComputedStyle(side[0].parentElement!).rowGap) || 0;
    grid.style.setProperty('--side-h', `${side.reduce((h, el) => h + el.offsetHeight, 0) + gap * (side.length - 1)}px`);
  };
  const sizes = new ResizeObserver(measure);
  side.forEach(el => sizes.observe(el));
  measure(); // at once, so the panel has its height before the observer's first report and does not grow on load

  // "Open all" is for the phone accordion; wide screens show one dimension at a time beside the list.
  const published = [...document.querySelectorAll<HTMLDetailsElement>('.evidence-section .ev-panel')];
  const btn = document.getElementById('open-all')!;
  btn.hidden = false;
  btn.addEventListener('click', () => {
    const open = !published.every(d => d.open);
    published.forEach(d => { d.open = open; });
  });
  // The label follows the panels, however they changed: this button, a tap on one panel, or a resize.
  const label = () => { btn.textContent = published.every(d => d.open) ? 'Close all' : 'Open all'; };
  published.forEach(d => d.addEventListener('toggle', label));
  label();

  // A thumbnail opens its photo and full credit in a dialog; without script it links to the large file. Esc and the
  // Close button close it natively, as does a click on the dimmed page; focus goes back to the thumbnail.
  for (const thumb of document.querySelectorAll<HTMLAnchorElement>('a[data-photo]')) {
    const dialog = document.getElementById(thumb.dataset.photo!) as HTMLDialogElement;
    thumb.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      dialog.showModal();
    });
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => thumb.focus());
  }
</script>
