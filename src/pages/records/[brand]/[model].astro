---
import Base from '../../../layouts/Base.astro';
import ProfileStrip from '../../../components/ProfileStrip.astro';
import ConfidenceMark from '../../../components/ConfidenceMark.astro';
import ProvisionalBanner from '../../../components/ProvisionalBanner.astro';
import EvidenceList from '../../../components/EvidenceList.astro';
import {
  DIMENSIONS, RELATIONSHIP, orgUrl, getCatalogue, correctionUrl, discussionUrl, fmtDate,
} from '../../../lib/data.ts';

const { classification, dimension, orgs, records } = await getCatalogue(Astro.locals);
const r = records.find(r => r.id === `${Astro.params.brand}/${Astro.params.model}`);
if (!r) return new Response('Record not found',{status:404});
const p = r.profile;
const noProfile = p.confidence === 'D';
const details = [
  ['Generation', r.generation], ['Reference', r.reference], ['Caliber', r.caliber], ['Production route', r.route_label],
  ['Made', r.production_start && `${r.production_start} to ${r.production_end ?? 'present'}`],
].filter(([, v]) => v) as [string, string | number][];
const provenanceByDim = DIMENSIONS.map(d => [d, r.provenance.filter(e => e.dimension === d)] as const).filter(([, es]) => es.length);
---
<Base
  title={`${r.brandName} ${r.model}`}
  description={`FALK profile and provenance evidence for the ${r.brandName} ${r.model}.`}
  image={{ path: `/og/records/${r.id}.png`, alt: `FALK profile of the ${r.brandName} ${r.model}: seven dimensions scored 0 to 5.` }}
>
  {p.is_seed && <ProvisionalBanner slot="banner" />}

  <header class="page-head app-head">
    <a class="brand-link" href={orgUrl(r.brand)}>{r.brandName}</a>
    <h1>{r.model}</h1>
    {details.length > 0 && <dl class="pairs small">{details.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
  </header>

  <div class="grid-2">
    <div class="stack">
      {noProfile
        ? <div class="no-profile"><p>Not enough evidence for a profile yet. Provenance notes are below.</p></div>
        : <div class="plate scroll profile-plate">
            <ProfileStrip caption="Profile" columns={[{ scores: p.scores }]} linkRows />
            <p class="small muted">Not a ranking. Darker means more of the work is done inside the brand. Select a measure to read its evidence.</p>
          </div>}
    </div>

    <aside class="plate summary" aria-label="Summary">
      {!noProfile && (
        <div class="cls-block">
          <h2 class="cls">{classification(p.classification[0], p.methodology).name}</h2>
          {p.classification.slice(1).map(c => <p class="muted">with {classification(c, p.methodology).name} traits</p>)}
          <p class="small muted">Classification</p>
        </div>
      )}
      {p.independent_watchmaker && <p class="iw">Independent watchmaker: an identifiable watchmaker personally performs substantial watchmaking and craft on these watches.</p>}
      <dl class="facts">
        <div><dt>Evidence</dt><dd><ConfidenceMark grade={p.confidence} /></dd></div>
        <div><dt>Scored with</dt><dd><a href="/methodology/">Methodology {p.methodology}</a></dd></div>
        <div><dt>Version</dt><dd>{p.version}, updated {fmtDate(p.created_on)}</dd></div>
        <div><dt>Provenance</dt><dd>{r.provenance.length} {r.provenance.length === 1 ? 'entry' : 'entries'}, {r.claims.length} {r.claims.length === 1 ? 'claim' : 'claims'}</dd></div>
      </dl>
      <div class="actions">
        <a class="btn" href={correctionUrl(r.id)}>Send a correction</a>
        <a href={`/records/${r.id}.json`}>Download JSON</a>
      </div>
    </aside>
  </div>

  <section class="block evidence-section">
    <div class="h2-row">
      <h2>Evidence by dimension</h2>
      <button class="btn secondary" type="button" id="open-all" hidden>Open all</button>
    </div>
    <EvidenceList profile={p} record={r} idPrefix="evidence" />
  </section>

  {r.draft && (
    <section class="block" id="draft">
      <h2>Draft under review</h2>
      <div class="provisional draft-note" role="note">
        <p><b>Version {r.draft.version} has not been checked by an editor yet.</b> It does not change the published profile above until it is approved.</p>
        <p class="small">{r.draft.change_note}</p>
      </div>
      <div class="plate scroll">
        <ProfileStrip caption="Published and draft profiles" columns={[
          { label: `Published, version ${p.version}`, scores: p.scores },
          { label: `Draft, version ${r.draft.version}`, scores: r.draft.scores },
        ]} />
      </div>
      <h3 class="draft-h">Draft evidence by dimension</h3>
      <EvidenceList profile={r.draft} record={r} idPrefix="draft-evidence" />
    </section>
  )}

  <section class:list={['block', { first: noProfile }]}>
    <h2>Who makes what</h2>
    {provenanceByDim.length === 0
      ? <p class="prose">No provenance entries recorded yet.</p>
      : (
        <table class="table stack-sm">
          <thead><tr><th scope="col">Area</th><th scope="col">Component</th><th scope="col">Made by</th><th scope="col">Relationship</th></tr></thead>
          <tbody>
            {provenanceByDim.flatMap(([d, es]) => es.map(e => (
              <tr>
                <td>{dimension[d].label}</td>
                <td>{e.component}{e.valid_from && <span class="small muted"> {e.valid_from} to {e.valid_to ?? 'present'}</span>}</td>
                <td>{e.performer ? <a href={orgUrl(e.performer)}>{orgs.get(e.performer)!.name}</a> : 'Unknown'}</td>
                <td><span class:list={['rel', e.relationship]}><span>{RELATIONSHIP[e.relationship]}</span></span></td>
              </tr>
            )))}
          </tbody>
        </table>
      )}
  </section>

  <section class="block">
    <h2>History</h2>
    <ol class="history">
      {[...r.profiles].reverse().map(v => {
        const prev = r.profiles.find(x => x.version === v.version - 1);
        const dims = prev ? DIMENSIONS.filter(d => prev.scores[d].value !== v.scores[d].value) : [];
        const changes = prev ? [
          ...dims.map(d => `${d} ${prev.scores[d].value ?? 'U'} → ${v.scores[d].value ?? 'U'}`),
          ...(prev.confidence !== v.confidence ? [`evidence ${prev.confidence} → ${v.confidence}`] : []),
          ...(prev.classification.join() !== v.classification.join() ? ['classification'] : []),
        ] : [];
        return (
          <li>
            <p><b>Version {v.version}</b> <span class="small">{fmtDate(v.created_on)}, {v.editor}</span>{v.status !== 'published' && <span class="small muted"> ({v.status})</span>}</p>
            <p class="prose">{v.change_note}</p>
            {prev && (
              <>
                <p class="small">{changes.length ? `Changed from version ${prev.version}: ${changes.join(', ')}.` : `No changes to scores, evidence grade or classification from version ${prev.version}.`}</p>
                <details class="compare">
                  <summary>Compare with version {prev.version}</summary>
                  <div class="plate scroll">
                    <ProfileStrip caption={`Version ${prev.version} and version ${v.version}`} marked={dims} columns={[
                      { label: `Version ${prev.version}`, scores: prev.scores },
                      { label: `Version ${v.version}`, scores: v.scores },
                    ]} />
                  </div>
                </details>
              </>
            )}
          </li>
        );
      })}
    </ol>
  </section>

  <section class="block">
    <h2>Use this record</h2>
    <div class="actions">
      <a href={`/records/${r.id}.json`}>Download JSON</a>
      <a href={correctionUrl(r.id)}>Send a correction</a>
      <a href={discussionUrl(r.id)}>Discuss this record</a>
    </div>
    {r.notes && <p class="small muted note">{r.notes}</p>}
  </section>
</Base>

<style>
  .scroll { overflow-x: auto; }
  .app-head { padding: var(--s-7) 0 var(--s-6); }
  .app-head > * + * { margin-top: var(--s-2); }
  .app-head h1 { font-size: 40px; }
  .brand-link { display: inline-block; padding: 12px 0; margin: -12px 0; font-size: 15px; font-weight: 500; text-decoration: none; }
  .brand-link:hover { text-decoration: underline; }
  .profile-plate { display: grid; gap: var(--s-4); height: 100%; align-content: space-between; }
  .summary { display: grid; align-content: start; gap: var(--s-5); }
  .cls { font-size: 28px; line-height: 1.15; font-stretch: 84%; }
  .cls-block > * + * { margin-top: var(--s-1); }
  .iw { font-size: 15px; line-height: 1.5; padding: var(--s-3) var(--s-4); border-radius: var(--r-control); background: var(--c-surface-2); }
  .facts { display: grid; gap: 0; margin: 0; }
  .facts div { display: grid; grid-template-columns: 8.5em 1fr; gap: var(--s-3); align-items: center; min-height: 44px; border-top: 1px solid color-mix(in srgb, var(--c-edge) 55%, transparent); }
  .facts dt { font-size: 14px; color: var(--c-ink-2); }
  .facts dd { margin: 0; font-size: 15px; }
  .h2-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3); margin-bottom: var(--s-5); }
  .history { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .history li > * + * { margin-top: var(--s-2); }
  .compare summary { cursor: pointer; color: var(--c-action); min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-underline-offset: 3px; }
  .compare[open] summary { margin-bottom: var(--s-3); }
  .note { margin-top: var(--s-4); }
  .first { order: -1; }
  .draft-note { padding: var(--s-4) var(--s-5); margin-bottom: var(--s-5); max-width: var(--measure); }
  .draft-note > * + * { margin-top: var(--s-2); }
  .draft-h { margin: var(--s-6) 0 var(--s-4); }
</style>

<script>
  const all = [...document.querySelectorAll<HTMLDetailsElement>('.evidence details')];
  const published = [...document.querySelectorAll<HTMLDetailsElement>('.evidence-section details')];
  const openFromHash = () => {
    const el = /^#(draft-)?evidence-/.test(location.hash) && document.getElementById(location.hash.slice(1));
    if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ block: 'start' }); }
  };
  addEventListener('hashchange', openFromHash);
  openFromHash();
  for (const d of all) d.addEventListener('toggle', () => {
    if (d.open && location.hash !== `#${d.id}`) history.replaceState(null, '', `#${d.id}`);
  });
  const btn = document.getElementById('open-all')!;
  btn.hidden = false;
  btn.addEventListener('click', () => {
    const open = !published.every(d => d.open);
    published.forEach(d => { d.open = open; });
    btn.textContent = open ? 'Close all' : 'Open all';
  });
</script>
