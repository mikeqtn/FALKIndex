---
import Base from '../../layouts/Base.astro';
import RecordTable from '../../components/RecordTable.astro';
import { DIMENSIONS, getCatalogue } from '../../lib/data.ts';
import { ARCHETYPES } from '../../lib/archetypes.ts';
const { dimension, methodology, records } = await getCatalogue(Astro.locals);

const archetypes = methodology.classifications.filter(c => c.kind === 'archetype');
const levels = [0, 1, 2, 3, 4, 5];
---
<Base title="Records" nav="records" description="Every FALK record, filterable by profile, classification, evidence and ownership.">
  <header class="page-head app-head">
    <h1>Records</h1>
    <p class="muted">{records.length} watches, each profiled by model, reference or production route. Filters narrow the list; nothing here is sorted by score.</p>
  </header>

  <div class="side-layout">
    <noscript><style>#filter-panel { display: none; }</style></noscript>
    <aside id="filter-panel">
      <details class="filter-sheet" id="filter-sheet">
        <summary class="btn secondary">Filters <span id="filter-count"></span></summary>
        <form id="filters" class="filters" role="search">
          <div class="field">
            <label for="q">Search</label>
            <input id="q" name="q" type="search" />
          </div>

          <fieldset>
            <legend>Dimension ranges</legend>
            {DIMENSIONS.map(d => {
              const k = d.toLowerCase();
              return (
                <div class="range">
                  <abbr title={dimension[d].label}>{d}</abbr>
                  <label class="sr-only" for={`${k}_min`}>{dimension[d].label} minimum</label>
                  <select id={`${k}_min`} name={`${k}_min`}>{levels.map(n => <option selected={n === 0}>{n}</option>)}</select>
                  <span aria-hidden="true">–</span>
                  <label class="sr-only" for={`${k}_max`}>{dimension[d].label} maximum</label>
                  <select id={`${k}_max`} name={`${k}_max`}>{levels.map(n => <option selected={n === 5}>{n}</option>)}</select>
                </div>
              );
            })}
            <label class="check note"><input type="checkbox" name="xu" value="1" /> Leave out unknown (U) in a narrowed range</label>
          </fieldset>

          <fieldset>
            <legend>Classification</legend>
            {archetypes.map(c => <label class="check" title={ARCHETYPES[c.code]?.short}><input type="checkbox" name="cls" value={c.code} /> {c.name}</label>)}
            <p class="check note"><a href="/archetypes/">What the archetypes mean</a></p>
          </fieldset>

          <fieldset>
            <legend>Evidence</legend>
            <div class="grades">{['A', 'B', 'C', 'D'].map(g => <label class="grade"><input type="checkbox" name="conf" value={g} /><span>{g}</span></label>)}</div>
          </fieldset>

          <fieldset>
            <legend>Ownership</legend>
            <label class="check"><input type="checkbox" name="own" value="independent" /> Independent</label>
            <label class="check"><input type="checkbox" name="own" value="group" /> Group-owned</label>
          </fieldset>

          <div class="field">
            <label for="scale">Scale</label>
            <select id="scale" name="scale">
              <option value="">Any</option>
              {['individual', 'small', 'medium', 'industrial'].map(s => <option value={s}>{s[0].toUpperCase() + s.slice(1)}</option>)}
            </select>
          </div>

          <button class="btn secondary clear" type="reset">Clear filters</button>
        </form>
      </details>
    </aside>

    <div class="stack">
      <div class="toolbar">
        <p id="count" aria-live="polite">{records.length} records</p>
        <label>Sort
          <select id="sort">
            <option value="brand">Brand A–Z</option>
            <option value="model">Model A–Z</option>
          </select>
        </label>
      </div>
      <RecordTable id="records" records={records} caption="All records" />
      <div id="empty" class="plate stack" hidden>
        <p>No records match these filters. Widen a dimension range or remove a classification.</p>
        <p><button class="btn secondary" type="button" id="clear-empty">Clear filters</button></p>
      </div>
    </div>
  </div>
</Base>

<style>
  /* Data terminal: compact controls, figures that stack, and every selection marked by ruby. */
  .app-head { padding: var(--s-7) 0 var(--s-6); }
  .app-head h1 { font-size: 40px; }
  .app-head p { max-width: 60ch; }
  .filters { display: grid; gap: var(--s-6); padding: var(--s-5); border-radius: var(--r-plate); background: var(--c-surface); }
  fieldset { border: 0; margin-inline: 0; padding: 0; display: grid; gap: 4px; }
  legend, .field > label { font-size: 13px; font-weight: 480; color: var(--c-ink-2); padding: 0 0 var(--s-2); }
  .field { display: grid; }
  .filters :global(select), .filters input[type="search"] { min-height: 36px; font-size: 14px; background-color: var(--c-surface-2); border-color: transparent; }
  .check { display: flex; gap: var(--s-3); align-items: center; min-height: 36px; font-size: 15px; cursor: pointer; }
  .check.note { font-size: 13px; line-height: 1.35; color: var(--c-ink-2); margin-top: var(--s-2); }
  .check input { width: 16px; height: 16px; margin: 0; flex: none; accent-color: var(--c-action); }
  .grades { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
  .grade { position: relative; }
  .grade input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .grade span { display: grid; place-items: center; height: 36px; border-radius: var(--r-control); background: var(--c-surface-2); font-weight: 600; transition: background var(--d-quick) var(--ease); }
  .grade:hover span { background: var(--c-edge); }
  .grade input:checked + span { background: var(--c-ink); color: var(--c-ink-inverse); }
  .grade input:focus-visible + span { outline: 2px solid var(--c-focus); outline-offset: 2px; }
  .range { display: grid; grid-template-columns: 3ch 1fr auto 1fr; gap: var(--s-2); align-items: center; }
  .range abbr { font-weight: 700; font-size: 17px; font-stretch: 62%; text-decoration: none; }
  .range span { color: var(--c-ink-2); }
  .clear { justify-self: start; min-height: 36px; padding: 0 var(--s-4); font-size: 14px; }
  .toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3); min-height: 36px; }
  .toolbar #count { font-size: 15px; font-weight: 560; }
  .toolbar label { display: flex; gap: var(--s-2); align-items: center; font-size: 14px; color: var(--c-ink-2); }
  .toolbar select { min-height: 36px; font-size: 14px; background-color: var(--c-surface); border-color: transparent; }
  .filter-sheet summary { list-style: none; }
  .filter-sheet summary::-webkit-details-marker { display: none; }
  .filter-sheet[open] summary { margin-bottom: var(--s-3); }
  @media (min-width: 1024px) { .filter-sheet summary { display: none; } }
</style>

<script>
  const DIMS = ['ma', 'mm', 'ex', 'dh', 'cf', 'we', 'pd'];
  const sheet = document.getElementById('filter-sheet') as HTMLDetailsElement;
  const form = document.getElementById('filters') as HTMLFormElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const tbody = document.querySelector('#records tbody')!;
  const rows = [...tbody.querySelectorAll<HTMLTableRowElement>('tr')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const badge = document.getElementById('filter-count')!;

  // Filters need JS; without it a noscript style hides the panel and the full table stays visible.
  const wide = matchMedia('(min-width: 1024px)');
  sheet.open = wide.matches;
  wide.addEventListener('change', e => { sheet.open = e.matches; });

  const isDefault = (k: string, v: string) => v === '' || (k.endsWith('_min') && v === '0') || (k.endsWith('_max') && v === '5');

  function fromUrl() {
    const p = new URLSearchParams(location.search);
    for (const el of form.elements as unknown as HTMLInputElement[]) {
      if (!el.name) continue;
      if (el.type === 'checkbox') el.checked = p.getAll(el.name).includes(el.value);
      else if (p.has(el.name)) el.value = p.get(el.name)!;
    }
    if (p.get('sort') === 'model') sort.value = 'model';
  }

  function apply() {
    const f = new FormData(form);
    const q = String(f.get('q') ?? '').trim().toLowerCase();
    const all = (k: string) => f.getAll(k) as string[];
    const cls = all('cls'), conf = all('conf'), own = all('own');
    const scale = String(f.get('scale') ?? '');
    const leaveOutU = f.get('xu') === '1';
    const ranges = DIMS.map(d => [d, Number(f.get(`${d}_min`)), Number(f.get(`${d}_max`))] as const)
      .filter(([, lo, hi]) => lo > 0 || hi < 5);

    let shown = 0;
    for (const r of rows) {
      const ds = r.dataset;
      const ok = (!q || ds.search!.includes(q))
        && (!cls.length || cls.some(c => ds.cls!.split(' ').includes(c)))
        && (!conf.length || conf.includes(ds.conf!))
        && (!own.length || own.includes(ds.own!))
        && (!scale || ds.scale === scale)
        && ranges.every(([d, lo, hi]) => ds[d] === 'U' ? !leaveOutU : Number(ds[d]) >= lo && Number(ds[d]) <= hi);
      r.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = shown === rows.length ? `${rows.length} records` : `${shown} of ${rows.length} records`;
    empty.hidden = shown > 0;

    const key = sort.value === 'model' ? 'model' : 'brand';
    rows.sort((a, b) => a.dataset[key]!.localeCompare(b.dataset[key]!) || a.dataset.model!.localeCompare(b.dataset.model!));
    tbody.append(...rows);

    const p = new URLSearchParams();
    for (const [k, v] of f) if (!isDefault(k, String(v))) p.append(k, String(v));
    const active = [...p.keys()].length;
    if (sort.value !== 'brand') p.set('sort', sort.value);
    badge.textContent = active ? `(${active})` : '';
    history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
  }

  fromUrl();
  apply();
  form.addEventListener('input', apply);
  form.addEventListener('submit', e => { e.preventDefault(); apply(); });
  form.addEventListener('reset', () => setTimeout(apply));
  sort.addEventListener('change', apply);
  document.getElementById('clear-empty')!.addEventListener('click', () => form.reset());
</script>
