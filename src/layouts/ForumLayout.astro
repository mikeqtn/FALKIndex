---
// The FALK Forum's own site: its own shell and layout, in FALK Index's colours and type (src/styles/shared.css).
// It does not use Base.astro or global.css, whose page styles would load on every forum page.
import '../styles/forum.css';
import '../styles/accounts.css';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
import AccountNavigation from '../components/accounts/AccountNavigation.tsx';
import { navCategories } from '../../server/forum.ts';
import { forumCanonical, forumPath, hasSession, siteHref } from '../lib/forum.ts';
// The theme script is hashed for the Content Security Policy in astro.config.mjs; never write an is:inline script here.
import { THEME_SCRIPT } from '../lib/inline-scripts.mjs';
import { allowClerkForHost } from '../lib/page-csp.ts';
allowClerkForHost(Astro);

interface Props {
  title: string; description?: string;
  nav?: string; // the current sidebar item: 'home', 'new', or a category id
  ld?: object;
}
const { title, description = 'Discussion of watches, how they are made, and the FALK Index. Anyone can read; post with your FALK Index account.', nav, ld } = Astro.props;
const pageTitle = title === 'FALK Forum' ? title : `${title}, FALK Forum`;
const canonical = forumCanonical(Astro.url.pathname);
const ldJson = ld && JSON.stringify({ '@context': 'https://schema.org', ...ld }).replaceAll('<', '\\u003c');
const categories = await navCategories();
const signedIn = hasSession(Astro.request.headers.get('cookie'));
const q = Astro.url.searchParams.get('q') ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="FALK Forum" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <script is:inline set:html={THEME_SCRIPT} />
  </head>
  <body class="f-body">
    <a class="sr-only f-skip" href="#main">Skip to content</a>
    <div class="f-frame">
      <details class="f-side" id="f-menu" open>
        <summary class="f-menu-button">Menu</summary>
        <nav class="f-side-nav" aria-label="Forum">
          <ul>
            <li><a href={forumPath('/')} data-astro-prefetch aria-current={nav === 'home' ? 'page' : undefined}>Forum home</a></li>
            <li><a href={forumPath('/threads/')} data-astro-prefetch aria-current={nav === 'threads' ? 'page' : undefined}>All threads</a></li>
          </ul>
          <div class="f-side-group">
          <h2>Categories</h2>
          <ul>
            {categories.map(c => <li><a href={forumPath(`/${c.id}/`)} data-astro-prefetch aria-current={nav === c.id ? 'page' : undefined}>{c.name}</a></li>)}
          </ul>
          </div>
          <div class="f-side-group">
          <h2>FALK Index</h2>
          <ul>
            <li class="f-side-home"><a href={siteHref('/') || '/'}>FALK Index home</a></li>
            <li><a href={siteHref('/records/')}>Records</a></li>
            <li><a href={siteHref('/methodology/')}>Methodology</a></li>
            <li><a href={siteHref('/about/')}>About the project</a></li>
            <li><a href={siteHref('/help/')}>Help</a></li>
            <li><a href={siteHref('/terms/')}>Terms of use</a></li>
            <li><a href={siteHref('/privacy/')}>Privacy</a></li>
          </ul>
          </div>
        </nav>
      </details>
      <header class="f-top">
        <a class="f-wordmark" href={forumPath('/')}>
          <span class="mark" aria-hidden="true"><i /><i /><i /><i /><i /><i /><i /></span>FALK Forum
        </a>
        <form class="f-search" action={forumPath('/search/')} method="get" role="search">
          <label class="sr-only" for="f-q">Search the forum</label>
          <input id="f-q" type="search" name="q" value={q} placeholder="Search threads and posts" minlength="2" maxlength="200" />
        </form>
        <div class="f-top-end">
          <button class="f-theme" type="button" aria-label="Dark mode" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          </button>
          {signedIn
            ? <AccountNavigation client:only="react" site={siteHref('')} forum={{ replies:forumPath('/notifications/'), moderation:forumPath('/moderation/') }}>
                <span slot="fallback" class="account-nav"><a href={forumPath('/notifications/')}>Replies</a><a href={`${siteHref('')}/account`}>Account</a><button type="button" disabled>Sign out</button></span>
              </AccountNavigation>
            : <span class="account-nav"><a href="/sign-in">Sign in</a><a class="account-button" href="/sign-up">Create account</a></span>}
          <a class="f-switch" href={siteHref('/') || '/'}>FALK Index</a>
        </div>
      </header>
      <main id="main" class="f-canvas">
        <slot />
        <div class="f-skeleton" aria-hidden="true">
          <i class="f-skel f-skel-title" />
          <div class="f-skel-thread">
            {[0, 1, 2].map(n => <div class="f-skel-card">
              <div class="f-skel-head"><i class="f-skel f-skel-avatar" /><i class="f-skel f-skel-name" /></div>
              {n === 0 ? <i class="f-skel f-skel-block" /> : <><i class="f-skel" /><i class="f-skel f-skel-short" /></>}
            </div>)}
          </div>
          <div class="f-skel-list">
            {[0, 1, 2, 3, 4, 5].map(() => <div class="f-skel-card"><i class="f-skel f-skel-short" /><i class="f-skel f-skel-meta" /></div>)}
          </div>
        </div>
      </main>
    </div>
    <script>
      // The menu renders open so its links work without script; below 900px it folds behind "Menu".
      const menu = document.getElementById('f-menu') as HTMLDetailsElement, wide = matchMedia('(min-width: 900px)');
      const fit = () => { menu.open = wide.matches; };
      fit(); wide.addEventListener('change', fit);
      // "/" jumps to forum search.
      addEventListener('keydown', e => {
        const t = e.target as HTMLElement;
        if (e.key !== '/' || e.metaKey || e.ctrlKey || t.closest('input, textarea, select, [contenteditable]')) return;
        const q = document.getElementById('f-q') as HTMLInputElement;
        if (q.offsetParent) { e.preventDefault(); q.focus(); }
      });
    </script>
    <script>
      // Separate from the script above, which stays small enough for Astro to inline, so the menu folds without waiting for a file.
      import { saveTheme } from '../lib/inline-scripts.mjs';
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.f-theme')!;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';
      const sync = () => toggle.setAttribute('aria-pressed', String(isDark()));
      toggle.addEventListener('click', () => {
        const theme = isDark() ? 'light' : 'dark';
        root.dataset.theme = theme;
        saveTheme(theme);
        sync();
      });
      systemDark.addEventListener('change', sync);
      sync();
    </script>
    <script>
      // While the next page on this site loads, swap the canvas for placeholder shapes (forum.css: .f-skeleton).
      // The short wait keeps prefetched pages, which arrive at once, from flashing them.
      const main = document.getElementById('main')!;
      let timer = 0;
      const loading = (url: URL) => {
        if (url.origin !== location.origin || (url.pathname === location.pathname && url.search === location.search)) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          main.dataset.skeleton = url.pathname.includes('/t/') ? 'thread' : 'list';
          main.setAttribute('aria-busy', 'true');
        }, 120);
      };
      // Runs after React's handlers, so links and forms the page handles itself (defaultPrevented) are left alone.
      document.addEventListener('click', e => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const link = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
        if (link && !link.target && !link.hasAttribute('download')) loading(new URL(link.href));
      });
      document.addEventListener('submit', e => {
        const form = e.target as HTMLFormElement;
        if (!e.defaultPrevented && form.method === 'get') loading(new URL(form.action));
      });
      // Back and forward can restore this page from the browser's cache, placeholders and all.
      addEventListener('pageshow', () => { clearTimeout(timer); delete main.dataset.skeleton; main.removeAttribute('aria-busy'); });
      // Fade from the shapes into the next page (forum.css), but only if they were showing: a page that arrived first
      // swaps in at once, as before.
      addEventListener('pageswap', e => {
        if (!main.dataset.skeleton) (e as Event & { viewTransition?: { skipTransition(): void } | null }).viewTransition?.skipTransition();
      });
    </script>
  </body>
</html>
