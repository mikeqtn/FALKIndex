---
import '../styles/global.css';
import '../styles/accounts.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { correctionUrl, getCatalogue } from '../lib/data.ts';
import AccountNavigation from '../components/accounts/AccountNavigation.tsx';
const { methodology } = await getCatalogue(Astro.locals);

interface Props {
  title: string; description?: string; nav?: 'records' | 'methodology' | 'sources' | 'data' | 'about';
  image?: { path: string; alt: string }; // share image (og:image), 1200×630
  ld?: object; // schema.org structured data for this page, rendered as JSON-LD
}
const { title, description = 'An evidence database of where the work on a watch is actually done.', nav, ld,
  image = { path: '/og/site.png', alt: 'FALK Index: where each watch is really made.' } } = Astro.props;
const pageTitle = title === 'FALK Index' ? title : `${title}, FALK Index`;
// Absolute URLs need the public domain; the published build sets PUBLIC_SITE_URL (see .replit).
const site = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '');
const canonical = site && `${site}${Astro.url.pathname}`;
const imageUrl = site && `${site}${image.path}`;
// JSON-LD is inert data, but a "</script>" inside a string would end the tag, so every < is escaped.
const ldJson = ld && JSON.stringify({ '@context': 'https://schema.org', ...ld }).replaceAll('<', '\\u003c');
// Clerk sets __client_uat (possibly with a suffix) to a timestamp after sign-in and 0 after sign-out.
// Signed-out readers get plain links, so Clerk's scripts load only for people with an account session.
const signedIn = (Astro.request.headers.get('cookie') ?? '').split(/;\s*/)
  .some(c => /^__client_uat(_[\w-]+)?=/.test(c) && Number(c.split('=')[1]) > 0);
const links = [
  ['records', '/records/', 'Records'],
  ['methodology', '/methodology/', 'Methodology'],
  ['sources', '/sources/', 'Sources'],
  ['data', '/data/', 'Data'],
  ['about', '/about/', 'About'],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Fetch the heading face up front so headings don't reflow when it arrives. -->
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="FALK Index" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={image.alt} />
    </>}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <script is:inline>
      // Apply a saved theme before first paint; with no saved choice the system setting applies.
      try { const t = localStorage.getItem('falk-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav">
      <nav class="wrap" aria-label="Main">
        <a class="wordmark" href="/"><span class="mark" aria-hidden="true"><i /><i /><i /><i /><i /><i /><i /></span>FALK Index</a>
        <details class="nav-menu" open>
          <summary>Menu</summary>
          <div class="nav-links">
            <ul>
              {links.map(([key, href, label]) => <li><a href={href} aria-current={nav === key ? 'page' : undefined}>{label}</a></li>)}
            </ul>
            <form class="nav-search" action="/records/" method="get" role="search">
              <label class="sr-only" for="nav-q">Search records</label>
              <input id="nav-q" type="search" name="q" placeholder="Search records" />
              <kbd aria-hidden="true">/</kbd>
            </form>
            <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
              <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
              <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            </button>
            {signedIn
              ? <AccountNavigation client:only="react">
                  <span slot="fallback" class="account-nav" role="status"><span class="sr-only">Loading account navigation</span><span class="account-skeleton" style="width: 84px" aria-hidden="true" /></span>
                </AccountNavigation>
              : <span class="account-nav"><a href="/sign-in">Sign in</a><a class="account-button" href="/sign-up">Create account</a></span>}
          </div>
        </details>
      </nav>
    </header>
    <script is:inline>
      // The menu renders open so links work without script; below 1100px it folds behind "Menu".
      (() => {
        const menu = document.querySelector('.nav-menu'), wide = matchMedia('(min-width: 1100px)');
        const fit = () => { menu.open = wide.matches; };
        fit(); wide.addEventListener('change', fit);
      })();
    </script>
    <slot name="banner" />
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-mark" aria-hidden="true">
          {['F', 'A', 'L', 'K', '', 'I', 'N', 'D', 'E', 'X'].map((l, i) => l
            ? <span style={`height:${[100, 82, 94, 70, 0, 64, 88, 76, 96, 72][i]}%`}>{l}</span>
            : <span class="gap" />)}
        </p>
        <div class="footer-cols">
          <div>
            <h2>The index</h2>
            <ul><li><a href="/records/">Records</a></li><li><a href="/sources/">Sources</a></li><li><a href="/data/">Data downloads</a></li></ul>
          </div>
          <div>
            <h2>The method</h2>
            <ul><li><a href="/methodology/">Methodology {methodology.code}</a></li><li><a href="/about/">About the project</a></li></ul>
          </div>
          <div>
            <h2>Take part</h2>
            <ul><li><a href={correctionUrl()}>Send a correction</a></li><li><a href="/sign-up">Create an account</a></li></ul>
          </div>
          <div>
            <h2>Terms</h2>
            <ul class="muted"><li>Data CC BY-SA 4.0, code MIT</li><li>No paid placement or sponsored scores</li></ul>
          </div>
        </div>
        <div class="footer-base small">
          <p class="muted">Provenance over prestige. Movement photographs via Wikimedia Commons: Nomos DUW 6101 by Anil Öztas (CC BY 4.0 and CC BY-SA 4.0); Omega cal. 1861 and 321 by Shane Lin (CC BY-SA 2.0); escapement and jewels by Hustvedt (CC BY-SA 3.0). Cropped and resized; <a href="/images/movements/CREDITS.txt">sources and licences</a>.</p>
          <a class="btn secondary" href={correctionUrl()}>Send a correction</a>
        </div>
      </div>
    </footer>
    <script>
      // Sections marked data-rise lift their parts in once as they enter. Without script, or with reduced motion, they simply show.
      const rise = document.querySelectorAll<HTMLElement>('[data-rise]');
      if (rise.length && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js');
        const io = new IntersectionObserver(entries => entries.forEach(e => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { rootMargin: '0px 0px -10% 0px' });
        rise.forEach(el => { [...el.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--n', String(i))); io.observe(el); });
      }
      // Figures marked data-roll count up once as they come into view; the real number is in the markup throughout.
      const figures = [...document.querySelectorAll<HTMLElement>('[data-roll]')];
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(entries => entries.forEach(e => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          const el = e.target as HTMLElement, end = Number(el.dataset.roll), t0 = performance.now();
          const step = (t: number) => {
            const k = Math.min(1, (t - t0) / 900), eased = 1 - Math.pow(1 - k, 3);
            el.textContent = String(Math.round(end * eased));
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }), { rootMargin: '0px 0px -15% 0px' });
        figures.forEach(f => io.observe(f));
      }
      // "/" jumps to record search, as in most reference tools.
      addEventListener('keydown', e => {
        const t = e.target as HTMLElement;
        if (e.key !== '/' || e.metaKey || e.ctrlKey || t.closest('input, textarea, select, [contenteditable]')) return;
        const q = document.getElementById('nav-q') as HTMLInputElement;
        const menu = q.closest('details');
        if (menu && getComputedStyle(menu.querySelector('summary')!).display !== 'none') menu.open = true;
        e.preventDefault(); q.focus();
      });
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';
      const sync = () => toggle.setAttribute('aria-pressed', String(isDark()));
      toggle.addEventListener('click', () => {
        const theme = isDark() ? 'light' : 'dark';
        root.dataset.theme = theme;
        try { localStorage.setItem('falk-theme', theme); } catch {}
        sync();
      });
      systemDark.addEventListener('change', sync);
      sync();
    </script>
  </body>
</html>
