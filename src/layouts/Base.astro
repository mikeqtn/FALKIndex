---
import '../styles/global.css';
import { correctionUrl, getCatalogue } from '../lib/data.ts';
import AccountNavigation from '../components/accounts/AccountNavigation.tsx';
const { methodology } = await getCatalogue(Astro.locals);

interface Props { title: string; description?: string; nav?: 'records' | 'methodology' | 'sources' | 'data' | 'about' }
const { title, description = 'An evidence database of where the work on a watch is actually done.', nav } = Astro.props;
const links = [
  ['records', '/records/', 'Records'],
  ['methodology', '/methodology/', 'Methodology'],
  ['sources', '/sources/', 'Sources'],
  ['data', '/data/', 'Data'],
  ['about', '/about/', 'About'],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'FALK Index' ? title : `${title}, FALK Index`}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Apply a saved theme before first paint; with no saved choice the system setting applies.
      try { const t = localStorage.getItem('falk-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-nav">
      <nav class="wrap" aria-label="Main">
        <a class="wordmark" href="/">FALK Index</a>
        <ul>
          {links.map(([key, href, label]) => <li><a href={href} aria-current={nav === key ? 'page' : undefined}>{label}</a></li>)}
        </ul>
        <form class="nav-search" action="/records/" method="get" role="search">
          <label class="sr-only" for="nav-q">Search records</label>
          <input id="nav-q" type="search" name="q" placeholder="Search records" />
        </form>
        <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <AccountNavigation client:only="react" />
      </nav>
    </header>
    <slot name="banner" />
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap stack small">
        <ul>
          <li><a href="/methodology/">Methodology {methodology.code}</a></li>
          <li>Data CC BY-SA 4.0, code MIT</li>
          <li>No paid placement or sponsored scores</li>
          <li><a href={correctionUrl()}>Send a correction</a></li>
        </ul>
        <p class="muted">Provenance over prestige.</p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const systemDark = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ?? (systemDark.matches ? 'dark' : 'light')) === 'dark';
      const sync = () => toggle.setAttribute('aria-pressed', String(isDark()));
      toggle.addEventListener('click', () => {
        const theme = isDark() ? 'light' : 'dark';
        root.dataset.theme = theme;
        try { localStorage.setItem('falk-theme', theme); } catch {}
        sync();
      });
      systemDark.addEventListener('change', sync);
      sync();
    </script>
  </body>
</html>
