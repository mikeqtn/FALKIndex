---
import type { recordThreads } from '../../../server/forum.ts';
import CompactStrip from '../CompactStrip.astro';
import { getCatalogue } from '../../lib/data.ts';
import { forumDate, forumPath, siteHref } from '../../lib/forum.ts';
type Thread = Awaited<ReturnType<typeof recordThreads>>[number];
interface Props { threads: Thread[]; empty: string; heading?: string; hideRecord?: boolean }
const { threads, empty, heading = 'Threads', hideRecord = false } = Astro.props;
const { records } = await getCatalogue(Astro.locals);
---
{threads.length ? <div class="f-plate">
<div class="f-columns"><span>{heading}</span><span>Replies</span><span>Last post</span></div>
 <ul class="f-threads">
  {threads.map(t => {
    const record = !hideRecord && t.record ? records.find(r => r.id === t.record) : undefined;
    return <li>
      <div>
        <a class="f-thread-title" href={forumPath(`/t/${t.id}`)}>{t.title}</a>
        {t.pinned && <span class="f-pill">Pinned</span>}
        {t.locked && <span class="f-pill quiet">Locked</span>}
        <p class="f-thread-meta">
          Started by {t.author.username ? <a href={siteHref(`/people/${t.author.username}/`)}>{t.author.displayName}</a> : t.author.displayName}
        </p>
        {record && <p class="f-thread-record">
          <CompactStrip scores={record.profile.scores} />
          <a href={forumPath(`/records/${record.id}/`)}>{record.brandName} {record.model}</a>
        </p>}
      </div>
      <div class="f-figure"><b>{t.replies}</b><span class="sr-only">{t.replies === 1 ? ' reply' : ' replies'}</span></div>
      <div class="f-figure"><span>{forumDate(t.lastPostAt)}</span></div>
    </li>;
  })}
</ul>
</div> : <p class="f-empty">{empty}</p>}
