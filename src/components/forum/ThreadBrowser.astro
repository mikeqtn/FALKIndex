---
import ThreadList from './ThreadList.astro';
import { THREAD_SORTS, type listAllThreads, type ThreadSort } from '../../../server/forum.ts';
interface Props { listing: NonNullable<Awaited<ReturnType<typeof listAllThreads>>>; sort: ThreadSort; empty: string; showCategory?: boolean }
const { listing, sort, empty, showCategory = false } = Astro.props;
const pages = Math.ceil(listing.total / listing.pageSize);
const quiet = { day:'No replies in the last 24 hours.', week:'No replies in the last 7 days.' } as Partial<Record<ThreadSort, string>>;
---
<nav class="f-sorts" aria-label="Sort threads">
  {Object.entries(THREAD_SORTS).map(([key, label]) => <a href={`?sort=${key}`} data-astro-prefetch aria-current={key === sort ? 'true' : undefined}>{label}</a>)}
</nav>
<ThreadList threads={listing.threads} heading={`${listing.total} ${listing.total === 1 ? 'thread' : 'threads'}`} empty={quiet[sort] ?? empty} showCategory={showCategory} />
{pages > 1 && <nav class="f-pages" aria-label="Pages">
  {Array.from({ length:pages }, (_, i) => i + 1).map(n => <a href={`?sort=${sort}&page=${n}`} aria-current={n === listing.page ? 'page' : undefined}>{n}</a>)}
</nav>}
