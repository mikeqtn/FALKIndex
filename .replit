modules = ["python-base-3.13", "nodejs-24", "postgresql-16"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FALK Index web"

[[workflows.workflow]]
name = "FALK Index web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- --ignore-lock"
waitForPort = 5000

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && PUBLIC_SITE_URL=https://falkindex.com npm run build"]
run = ["npm", "start"]

[[ports]]
localPort = 4321
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 4322
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5055
externalPort = 3001

[[ports]]
localPort = 5077
externalPort = 3002

[[ports]]
localPort = 5099
externalPort = 4200

[userenv]

[userenv.production]
FORUM_HOST = "forum.falkindex.com"

[objectStorage]
defaultBucketID = "replit-objstore-e70bf5ff-4478-4f22-9bf0-962e277f563e"
